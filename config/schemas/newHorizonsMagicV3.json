{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons magic rules v3",
	"description": "New Horizons magic rules with saved direct-damage formulas, explicit school-rank Spell Power coefficient factors, optional saved Spellcraft efficiency, optional per-row active, hero-access, and ordinary-acquisition state, and optional Cure-affliction mode. Missing hero-access markers preserve older profiles as accessible; missing ordinary-acquisition markers preserve older profiles as eligible. Older snapshots without Spellcraft efficiency retain 100% Spellcraft. Runtime validation rejects the incompatible combination of fixed Mage Guild generation and faction weights.",
	"type": "object",
	"required": ["schemaVersion", "rulesetVersion", "schoolRankPowerCoefficientPercent", "schools", "spells", "schoolSkills", "skillReplacements"],
	"dependencies": {"mageGuildGeneration": ["factions"]},
	"additionalProperties": false,
	"properties": {
		"schemaVersion": {"type": "integer", "enum": [1]},
		"rulesetVersion": {"type": "integer", "enum": [3]},
		"morale": {
			"$ref": "vcmi:newHorizonsMagic#/definitions/morale",
			"description": "Optional captured v3 Morale curve. Absence retains earlier profiles. Runtime additionally checks every chance is no greater than the captured diceSize."
		},
		"protectedAdventureBarriers": {
			"type": "boolean",
			"description": "Opt in to authored Fly/Dimension Door barriers and accepted flight source-layer receipts. Absence preserves earlier profiles."
		},
		"creatureAbilities": {
			"type": "object",
			"required": ["rulesetVersion", "freezingTouchChancePercent", "shatterBonusPercent"],
			"additionalProperties": false,
			"properties": {
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"freezingTouchChancePercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"shatterBonusPercent": {"type": "integer", "minimum": 0, "maximum": 100}
			},
			"description": "Captured creature ability rules. Omission disables Freezing Touch and its shatter bonus in older profiles."
		},
		"schoolRankPowerCoefficientPercent": {
			"type": "array",
			"minItems": 4,
			"maxItems": 4,
			"additionalItems": false,
			"items": [
				{"type": "integer", "enum": [100]},
				{"type": "integer", "enum": [115]},
				{"type": "integer", "enum": [130]},
				{"type": "integer", "enum": [145]}
			],
			"description": "Spell Power coefficient multiplier by school rank: no rank, Basic, Advanced, Expert. Fixed spell base values remain unchanged."
		},
		"spellcraftEfficiencyPercent": {
			"type": "array",
			"minItems": 4,
			"maxItems": 4,
			"additionalItems": false,
			"items": [
				{"type": "integer", "enum": [100]},
				{"type": "integer", "enum": [110]},
				{"type": "integer", "enum": [120]},
				{"type": "integer", "enum": [130]}
			],
			"description": "Optional Spellcraft multiplier for Spell Power-derived spell terms by Skill rank: no rank, Basic, Advanced, Expert. Omission keeps older v3 snapshots at 100% Spellcraft."
		},
		"physicalDamageReductionCapPercent": {
			"type": "integer", "not": {"type": "null"}, "minimum": 0, "maximum": 100,
			"description": "Opt in to multiplicative independent physical reductions capped at this percentage. Omission preserves historical damage rules."
		},
		"spellPoints": {
			"type": "object",
			"not": {"type": "null"},
			"required": ["rulesetVersion", "intelligenceMaximumPercent"],
			"additionalProperties": false,
			"properties": {
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"intelligenceMaximumPercent": {"type": "integer", "not": {"type": "null"}, "minimum": 100, "maximum": 1000}
			},
			"description": "Opt in to separate Normal and Buffer Spell Points. Omission preserves legacy single-pool semantics."
		},
		"mageGuildGeneration": {
			"type": "object",
			"not": {"type": "null"},
			"required": ["rulesetVersion", "nonPreferredSlots"],
			"additionalProperties": false,
			"properties": {
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"nonPreferredSlots": {
					"type": "array",
					"minItems": 5,
					"maxItems": 5,
					"additionalItems": false,
					"items": [
						{"type": "integer", "enum": [3]},
						{"type": "integer", "enum": [2]},
						{"type": "integer", "enum": [0]},
						{"type": "integer", "enum": [0]},
						{"type": "integer", "enum": [0]}
					]
				}
			},
			"description": "Opt in to fixed-school Mage Guild generation. Each level receives one slot for each preferred school plus the configured number of distinct non-preferred schools."
		},
		"warcasting": {
			"type": "boolean",
			"not": {"type": "null"},
			"description": "Enable alternating Hero Action empowerment. Absence or false preserves pre-Warcasting battle rules."
		},
		"schools": {
			"type": "array",
			"minItems": 6,
			"maxItems": 6,
			"uniqueItems": true,
			"items": {"$ref": "vcmi:newHorizonsMagic#/definitions/school"}
		},
		"adventureSpells": {
			"type": "object",
			"minProperties": 5,
			"maxProperties": 5,
			"additionalProperties": false,
			"required": ["core:summonBoat", "core:waterWalk", "core:townPortal", "core:fly", "core:dimensionDoor"],
			"properties": {
				"core:summonBoat": {"$ref": "vcmi:newHorizonsMagic#/definitions/adventureSpell"},
				"core:waterWalk": {"$ref": "vcmi:newHorizonsMagic#/definitions/waterWalkAdventureSpell"},
				"core:townPortal": {"$ref": "vcmi:newHorizonsMagic#/definitions/adventureSpell"},
				"core:fly": {"$ref": "vcmi:newHorizonsMagic#/definitions/adventureSpell"},
				"core:dimensionDoor": {"$ref": "vcmi:newHorizonsMagic#/definitions/adventureSpell"}
			}
		},
		"spells": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {"$ref": "#/definitions/spell"}
		},
		"schoolSkills": {
			"type": "object",
			"required": ["new-horizons:light", "new-horizons:nature", "new-horizons:sorcery", "new-horizons:havoc", "new-horizons:shadow", "new-horizons:chaos"],
			"additionalProperties": false,
			"properties": {
				"new-horizons:light": {"type": "string", "enum": ["new-horizons:lightMagic"]},
				"new-horizons:nature": {"type": "string", "enum": ["new-horizons:natureMagic"]},
				"new-horizons:sorcery": {"type": "string", "enum": ["new-horizons:sorceryMagic"]},
				"new-horizons:havoc": {"type": "string", "enum": ["new-horizons:havocMagic"]},
				"new-horizons:shadow": {"type": "string", "enum": ["new-horizons:shadowMagic"]},
				"new-horizons:chaos": {"type": "string", "enum": ["new-horizons:chaosMagic"]}
			}
		},
		"skillReplacements": {
			"type": "object",
			"required": ["core:airMagic", "core:fireMagic", "core:waterMagic", "core:earthMagic"],
			"additionalProperties": false,
			"properties": {
				"core:airMagic": {"type": "string", "enum": ["new-horizons:sorceryMagic"]},
				"core:fireMagic": {"type": "string", "enum": ["new-horizons:havocMagic"]},
				"core:waterMagic": {"type": "string", "enum": ["new-horizons:lightMagic"]},
				"core:earthMagic": {"type": "string", "enum": ["new-horizons:natureMagic"]}
			}
		},
		"factions": {
			"type": "object",
			"additionalProperties": {"$ref": "#/definitions/faction"}
		},
		"factionWeights": {
			"type": "object",
			"required": ["major", "minor"],
			"additionalProperties": false,
			"properties": {
				"major": {"type": "integer", "minimum": 1, "maximum": 1000},
				"minor": {"type": "integer", "minimum": 1, "maximum": 1000}
			}
		}
	},
	"definitions": {
		"spell": {
			"type": "object",
			"required": ["schools"],
			"additionalProperties": false,
			"properties": {
				"schools": {
					"type": "array",
					"minItems": 1,
					"maxItems": 6,
					"uniqueItems": true,
					"items": {"$ref": "vcmi:newHorizonsMagic#/definitions/school"}
				},
				"level": {"type": "integer", "minimum": 1, "maximum": 5},
				"costs": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": {"type": "integer", "not": {"type": "null"}, "minimum": 0, "maximum": 1000000}
				},
				"active": {"type": "boolean", "not": {"type": "null"}},
				"ordinaryAcquisition": {
					"type": "boolean",
					"not": {"type": "null"},
					"description": "Whether this spell may be learned through ordinary acquisition. Omission defaults to true for compatibility with older saved profiles."
				},
				"heroAccess": {
					"type": "boolean",
					"not": {"type": "null"},
					"description": "Whether heroes may cast and acquire this common spell. Omission defaults to true for compatibility with older saved-v3 profiles; this does not disable creature or world-effect behavior."
				},
				"directDamage": {"$ref": "#/definitions/directDamage"},
				"ignoreInterveningBarriers": {
					"type": "boolean",
					"not": {"type": "null"},
					"description": "Optional exact Teleport policy; true bypasses intervening barriers only, preserving endpoint legality. Absence retains saved legacy rank restrictions."
				},
				"burnGroundedFlyers": {
					"type": "boolean",
					"not": {"type": "null"},
					"description": "Optional exact Fire Wall policy: flyers landing or beginning an activation in flame burn; airborne transit remains exempt."
				},
				"temporaryMagicalEffectsOnly": {
					"type": "boolean",
					"not": {"type": "null"},
					"description": "Optional exact Dispel policy restricting removal to temporary magical spell effects."
				},
				"schoolRankDurations": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": {"type": "integer", "not": {"type": "null"}, "minimum": 1},
					"description": "Optional exact Curse duration table for None/Basic/Advanced/Expert; runtime validation checks the authored values and family."
				},
				"implosion": {
					"type": "object",
					"additionalProperties": false,
					"required": ["baseBasisPoints", "powerBasisPointsPerSpellPower", "maximumBasisPoints", "pullRadius", "pullDistance"],
					"properties": {
						"baseBasisPoints": {"type": "integer", "not": {"type": "null"}, "minimum": 0, "maximum": 10000},
						"powerBasisPointsPerSpellPower": {"type": "integer", "not": {"type": "null"}, "minimum": 1, "maximum": 10000},
						"maximumBasisPoints": {"type": "integer", "not": {"type": "null"}, "minimum": 0, "maximum": 10000},
						"pullRadius": {"type": "integer", "not": {"type": "null"}, "minimum": 1, "maximum": 11},
						"pullDistance": {"type": "integer", "not": {"type": "null"}, "enum": [1]}
					}
				},
				"propagationLimit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 2147483646,
					"description": "Optional saved-v3 Plague recipients per processed tick. Only new-horizons:plague may use this field; omission preserves the ordinary limit of one. Captured infections retain their original effective limit."
				},
				"cureAfflictions": {
					"description": "Optional explicit opt-in for the New Horizons Cure behavior. When present, Cure can remove one listed spell-effect source group from a single friendly living target; omission preserves legacy Cure behavior in older saved snapshots.",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {"type": "string", "enum": ["core:poison", "core:disease"]}
				},
				"restoration": {
					"description": "Optional saved-v3 Resurrection restoration behavior. Only core:resurrection may opt in; omission preserves older saved spell behavior.",
					"type": "object",
					"required": ["version"],
					"additionalProperties": false,
					"properties": {
						"version": {"type": "integer", "enum": [1]}
					}
				},
				"selectedPlacement": {"type": "boolean", "enum": [true]},
				"structures": {
					"type": "object",
					"additionalProperties": false,
					"required": ["fortificationDamagePercent", "destroyOrdinaryObstacles"],
					"properties": {
						"fortificationDamagePercent": {"type": "integer", "minimum": 1, "maximum": 10000},
						"destroyOrdinaryObstacles": {"type": "boolean", "enum": [true]}
					},
					"description": "Optional saved-v3 Havoc structural effects. Omission preserves older saved spell behavior; percentages are tunable prototype values."
				},
				"earthquake": {
					"type": "object",
					"additionalProperties": false,
					"required": ["radius", "duration", "movementCost", "structuralDamage", "baseSections", "maxSections", "powerPerSection", "baseDamage", "powerNumerator", "powerDivisor"],
					"properties": {
						"radius": {"type": "integer", "enum": [2]},
						"duration": {"type": "integer", "enum": [3]},
						"movementCost": {"type": "integer", "enum": [1]},
						"structuralDamage": {"type": "integer", "minimum": 1, "maximum": 10000},
						"baseSections": {"type": "integer", "enum": [2]},
						"maxSections": {"type": "integer", "enum": [4]},
						"powerPerSection": {"type": "integer", "enum": [80]},
						"baseDamage": {"type": "integer", "enum": [30]},
						"powerNumerator": {"type": "integer", "enum": [4]},
						"powerDivisor": {"type": "integer", "enum": [5]}
					}
				},
				"variant": {
					"type": "object",
					"required": ["base", "skill", "perk", "powerPercent"],
					"additionalProperties": false,
					"oneOf": [
						{"properties": {"powerPercent": {"enum": [100]}}},
						{"properties": {"powerPercent": {"enum": [60]}, "base": {"enum": ["core:slow"]}}}
					],
					"properties": {
						"base": {"type": "string", "minLength": 1},
						"skill": {"type": "string", "minLength": 1},
						"perk": {"type": "string", "minLength": 1},
						"powerPercent": {"type": "integer", "enum": [60, 100]}
					}
				}
			}
		},
		"directDamage": {
			"type": "object",
			"not": {"type": "null"},
			"required": ["base", "powerCoefficient"],
			"additionalProperties": false,
			"properties": {
				"base": {"type": "integer", "not": {"type": "null"}, "minimum": 0, "maximum": 1000000},
				"powerCoefficient": {"type": "integer", "not": {"type": "null"}, "minimum": 0, "maximum": 1000000}
			}
		},
		"faction": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"preferredA": {"$ref": "vcmi:newHorizonsMagic#/definitions/school"},
				"preferredB": {"$ref": "vcmi:newHorizonsMagic#/definitions/school"},
				"major": {"$ref": "vcmi:newHorizonsMagic#/definitions/school"},
				"minor": {"$ref": "vcmi:newHorizonsMagic#/definitions/school"},
				"provisional": {"type": "boolean"}
			},
			"oneOf": [
				{
					"required": ["preferredA", "preferredB"],
					"not": {"anyOf": [{"required": ["major"]}, {"required": ["minor"]}]}
				},
				{
					"required": ["major", "minor"],
					"not": {"anyOf": [{"required": ["preferredA"]}, {"required": ["preferredB"]}]}
				}
			]
		}
	}
}
