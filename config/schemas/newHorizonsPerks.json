				"new-horizons:lightMagic": {
					"type": "object",
					"required": ["id", "name", "domain", "availability", "description", "ranks", "perks"],
					"additionalProperties": false,
					"properties": {
						"id": {"enum": ["new-horizons:lightMagic"]},
						"name": {"type": "string", "minLength": 1},
						"domain": {"type": "string", "enum": ["Martial", "Magic", "Hybrid", "Strategic", "Faction"]},
