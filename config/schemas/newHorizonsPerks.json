						"description": {"type": "string", "minLength": 1},
						"details": {"type": "string", "minLength": 1},
						"ranks": {
							"type": "object",
							"required": ["basic", "advanced", "expert"],
							"additionalProperties": false,
							"properties": {
								"basic": {
									"type": "object",
									"required": ["description", "effect"],
									"additionalProperties": false,
									"properties": {
										"description": {"type": "string", "minLength": 1},
										"details": {"type": "string", "minLength": 1},
										"effect": {"$ref": "#/definitions/effect"},
										"mechanics": {"$ref": "#/definitions/preparedRankMechanicsV1"}
									}
								},
								"advanced": {
									"type": "object",
									"required": ["description", "effect"],
									"additionalProperties": false,
									"properties": {
										"description": {"type": "string", "minLength": 1},
										"details": {"type": "string", "minLength": 1},
										"effect": {"$ref": "#/definitions/effect"},
										"mechanics": {"$ref": "#/definitions/preparedRankMechanicsV1"}
									}
								},
								"expert": {
									"type": "object",
									"required": ["description", "effect"],
									"additionalProperties": false,
									"properties": {
										"description": {"type": "string", "minLength": 1},
										"details": {"type": "string", "minLength": 1},
										"effect": {"$ref": "#/definitions/effect"},
										"mechanics": {"$ref": "#/definitions/preparedRankMechanicsV1"}
									}
								}
							}
						},
						"perks": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/definitions/perk"}}
					}
				},
				"new-horizons:chaosMagic": {
