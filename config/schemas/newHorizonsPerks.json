	"definitions": {
		"commandAuthorityPolicy": {
			"type": "object", "additionalProperties": false,
			"required": ["version"], "properties": {"version": {"type": "integer", "enum": [1]}}
		},
		"commandAuthorityParameters": {
			"type": "object", "additionalProperties": false, "minProperties": 1,
			"properties": {
				"commandBonus": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"orderEfficiencyPercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"attackEfficiencyBonusPP": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"defenseEfficiencyBonusPP": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"firstOrderEfficiencyBonusPP": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"allEfficiencyBonusPP": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"efficiencyBonusPPPerMorale": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"maximumEfficiencyBonusPP": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"creatureAttack": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"creatureDefense": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"maximumHealthPercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"initiative": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"battlefieldSpeed": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"additionalRetaliations": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"magicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"directAttackDamagePercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"attackAndSpellReductionPercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"focusFireMeleeBonusPercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"feintReductionBonusPP": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"feintReductionCapPercent": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"requiresActiveOrder": {"enum": [true]},
				"slotGrades": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["core", "elite", "champion"]}}
			}
		},
		"passiveFactionSkillPolicyV2": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1, "required": ["version"], "properties": {"version": {"type": "integer", "enum": [2]}}, "description": "Captured version 2 selects the revised faction Skill. Absence preserves its historical policy and definitions."},
		"metamagicPolicyV3": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"type": "integer", "enum": [3]}, "adeptAdditionalPoints": {"type": "integer", "minimum": 0, "maximum": 12}}},
		"necromancyPolicy": {
			"oneOf": [
				{"$ref": "#/definitions/necromancyPolicyV1"},
				{"$ref": "#/definitions/necromancyPolicyV2"},
				{"$ref": "#/definitions/necromancyPolicyV3"}
			]
		},
		"necromancyPolicyV1": {
			"type": "object",
			"additionalProperties": false,
			"description": "Captured Skeleton-focused Necromancy. Absence preserves historical perk meanings and conversions. Leadership requirements are discounted once, rounded upward and bounded below by one; Lord of the Dead replaces the rank reduction.",
			"required": ["version", "skeletonLeadershipReductionPercent", "lordOfTheDeadLeadershipReductionPercent", "deathMarchSpeed", "bonewardMagicalReductionPercent", "tombGuardAdditionalRetaliations", "graveplatePhysicalReductionPercent", "graveKnowledgeRecoveryPercent"],
			"properties": {
				"version": {"type": "integer", "enum": [1]},
				"skeletonLeadershipReductionPercent": {
					"type": "array", "minItems": 4, "maxItems": 4, "additionalItems": false,
					"description": "Reduction by Skill rank: no Skill, Basic, Advanced, Expert.",
					"items": [
						{"type": "integer", "enum": [0]},
						{"type": "integer", "minimum": 0, "maximum": 99},
						{"type": "integer", "minimum": 0, "maximum": 99},
						{"type": "integer", "minimum": 0, "maximum": 99}
					]
				},
				"lordOfTheDeadLeadershipReductionPercent": {"type": "integer", "minimum": 0, "maximum": 99},
				"deathMarchSpeed": {"type": "integer", "minimum": 0, "maximum": 100},
				"bonewardMagicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"tombGuardAdditionalRetaliations": {"type": "integer", "minimum": 0, "maximum": 100},
				"graveplatePhysicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"graveKnowledgeRecoveryPercent": {"type": "integer", "minimum": 0, "maximum": 100}
			}
		},
		"necromancyPolicyV2": {
			"type": "object",
			"additionalProperties": false,
			"description": "Captured revised Skeleton-focused Necromancy. Version 1 and absence retain their historical perk meanings. Leadership requirements are discounted once, rounded upward and bounded below by one; Lord of the Dead replaces the rank reduction.",
			"required": ["version", "skeletonLeadershipReductionPercent", "lordOfTheDeadLeadershipReductionPercent", "deathMarchSpeed", "bonewardMagicalReductionPercent", "tombGuardAdditionalRetaliations", "graveplatePhysicalReductionPercent", "graveKnowledgeRecoveryPercent", "bonewardMagicResistancePercent", "tombGuardDoubleStrike", "deadMansLuckBonus", "boneCollectorRaiseBonusPercent", "soulHarvesterManaPerRaisedCreature", "soulHarvesterManaCap"],
			"properties": {
				"version": {"type": "integer", "enum": [2]},
				"skeletonLeadershipReductionPercent": {
					"type": "array", "minItems": 4, "maxItems": 4, "additionalItems": false,
					"description": "Reduction by Skill rank: no Skill, Basic, Advanced, Expert.",
					"items": [
						{"type": "integer", "enum": [0]},
						{"type": "integer", "minimum": 0, "maximum": 99},
						{"type": "integer", "minimum": 0, "maximum": 99},
						{"type": "integer", "minimum": 0, "maximum": 99}
					]
				},
				"lordOfTheDeadLeadershipReductionPercent": {"type": "integer", "minimum": 0, "maximum": 99},
				"deathMarchSpeed": {"type": "integer", "minimum": 0, "maximum": 100},
				"bonewardMagicalReductionPercent": {"type": "integer", "enum": [0]},
				"tombGuardAdditionalRetaliations": {"type": "integer", "enum": [0]},
				"graveplatePhysicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"graveKnowledgeRecoveryPercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"bonewardMagicResistancePercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"tombGuardDoubleStrike": {"type": "boolean"},
