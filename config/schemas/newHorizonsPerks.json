{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "New Horizons generic Skills and perks",
	"description": "Canonical data-only registry for the 31 New Horizons Skills and their ten-perk pools. Effect status is explicit: planned effects are source design records and must not be treated as active runtime behavior.",
	"type": "object",
	"additionalProperties": false,
	"dependencies": {
		"perkProgressionPolicyVersion": {
			"properties": {"offerWeightPolicyVersion": {"enum": [2]}},
			"dependencies": {"perkProgressionPolicyVersion": ["offerWeightPolicyVersion", "perkOfferNormalization"]}
		}
	},
	"required": [
		"schemaVersion",
		"rulesetVersion",
		"sourceDocument",
		"sourceSha256",
		"maxSkillChoices",
		"maxPerkChoices",
		"maxPerksPerSkill",
		"skills"
	],
	"properties": {
		"schemaVersion": {"type": "integer", "enum": [1]},
		"rulesetVersion": {"type": "integer", "enum": [1, 2]},
		"offerWeightPolicyVersion": {"type": "integer", "enum": [1, 2], "description": "Captured weighting:1 full per-perk raw weights;2 normalized parent-first offers. Without an independent progression marker,2 retains historical same-tier selections."},
		"perkProgressionPolicyVersion": {"type": "integer", "enum": [1], "not": {"type": "null"}, "description": "Captured1 requires weight policy2 and permits only the next missing perk tier, one perk per tier and one offered alternative per parent. Absence preserves historical progression."},
		"necromancyPolicy": {"$ref": "#/definitions/necromancyPolicy"},
		"perkOfferNormalization": {
			"type": "object", "not": {"type": "null"}, "additionalProperties": false,
			"minProperties": 2, "maxProperties": 2,
			"required": ["maximumPreferenceRatio", "mathVersion"],
			"properties": {
				"maximumPreferenceRatio": {"type": "number", "minimum": 1, "not": {"type": "null"}},
				"mathVersion": {"type": "integer", "enum": [1], "not": {"type": "null"}}
			}
		},
		"sourceDocument": {"type": "string", "minLength": 1},
		"sourceSha256": {"type": "string", "minLength": 64, "maxLength": 64},
		"maxSkillChoices": {"type": "integer", "enum": [2]},
		"maxPerkChoices": {"type": "integer", "enum": [2]},
		"maxPerksPerSkill": {"type": "integer", "enum": [3]},
		"skills": {
			"type": "object",
			"minProperties": 31,
			"maxProperties": 31,
			"additionalProperties": {"$ref": "#/definitions/skill"}
		}
	},
	"definitions": {
		"necromancyPolicy": {
			"type": "object",
			"additionalProperties": false,
			"description": "Captured Skeleton-focused Necromancy. Absence preserves historical perk meanings and conversions. Leadership requirements are discounted once, rounded upward and bounded below by one; Lord of the Dead replaces the rank reduction.",
			"required": ["version", "skeletonLeadershipReductionPercent", "lordOfTheDeadLeadershipReductionPercent", "deathMarchSpeed", "bonewardMagicalReductionPercent", "tombGuardAdditionalRetaliations", "graveplatePhysicalReductionPercent", "graveKnowledgeRecoveryPercent"],
			"properties": {
				"version": {"type": "integer", "enum": [1]},
				"skeletonLeadershipReductionPercent": {
					"type": "array", "minItems": 4, "maxItems": 4, "additionalItems": false,
					"description": "Reduction by Skill rank: no Skill, Basic, Advanced, Expert.",
					"items": [
						{"type": "integer", "enum": [0]},
						{"type": "integer", "minimum": 0, "maximum": 99},
						{"type": "integer", "minimum": 0, "maximum": 99},
						{"type": "integer", "minimum": 0, "maximum": 99}
					]
				},
				"lordOfTheDeadLeadershipReductionPercent": {"type": "integer", "minimum": 0, "maximum": 99},
				"deathMarchSpeed": {"type": "integer", "minimum": 0, "maximum": 100},
				"bonewardMagicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"tombGuardAdditionalRetaliations": {"type": "integer", "minimum": 0, "maximum": 100},
				"graveplatePhysicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
				"graveKnowledgeRecoveryPercent": {"type": "integer", "minimum": 0, "maximum": 100}
			}
		},
		"effect": {
			"type": "object",
			"required": ["status", "description"],
			"additionalProperties": false,
			"properties": {
				"status": {"type": "string", "enum": ["active", "planned"]},
				"description": {"type": "string", "minLength": 1}
			}
		},
		"rank": {
			"type": "object",
			"required": ["description", "effect"],
			"additionalProperties": false,
			"properties": {
				"description": {"type": "string", "minLength": 1},
				"effect": {"$ref": "#/definitions/effect"}
			}
		},
		"perk": {
			"type": "object",
			"required": ["id", "name", "requires", "description", "effect"],
			"additionalProperties": false,
			"properties": {
				"id": {"type": "string", "minLength": 1},
				"name": {"type": "string", "minLength": 1},
				"requires": {"type": "string", "enum": ["basic", "advanced", "expert"]},
				"description": {"type": "string", "minLength": 1},
				"effect": {"$ref": "#/definitions/effect"}
			}
		},
		"skill": {
			"type": "object",
			"required": ["id", "name", "domain", "availability", "description", "ranks", "perks"],
			"additionalProperties": false,
			"properties": {
				"id": {"type": "string", "minLength": 1},
				"name": {"type": "string", "minLength": 1},
				"domain": {"type": "string", "enum": ["Martial", "Magic", "Hybrid", "Strategic", "Faction"]},
				"availability": {
					"type": "string",
					"enum": ["All heroes", "Might-exclusive", "Magic-exclusive", "Castle heroes only", "Rampart heroes only", "Tower heroes only", "Dungeon heroes only", "Inferno heroes only", "Necropolis heroes only", "Stronghold heroes only", "Fortress heroes only", "Conflux heroes only"]
				},
				"description": {"type": "string", "minLength": 1},
				"ranks": {
					"type": "object",
					"required": ["basic", "advanced", "expert"],
					"additionalProperties": false,
					"properties": {
						"basic": {"$ref": "#/definitions/rank"},
						"advanced": {"$ref": "#/definitions/rank"},
						"expert": {"$ref": "#/definitions/rank"}
					}
				},
				"perks": {
					"type": "array",
					"minItems": 10,
					"maxItems": 10,
					"items": {"$ref": "#/definitions/perk"}
				}
			}
		}
	}
}
