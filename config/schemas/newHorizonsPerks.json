{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "New Horizons generic Skills and perks",
	"description": "Captured Skills and ten-perk pools: Command/Authority policy 1 requires 32 Skills; historical absence retains 31. Planned effects are not active runtime behavior.",
	"type": "object",
	"additionalProperties": false,
	"dependencies": {
		"perkProgressionPolicyVersion": {
			"properties": {"offerWeightPolicyVersion": {"enum": [2]}},
			"dependencies": {"perkProgressionPolicyVersion": ["offerWeightPolicyVersion", "perkOfferNormalization"]}
		}
	},
	"required": [
		"schemaVersion",
		"rulesetVersion",
		"elementalAttunementPolicy",
		"sourceDocument",
		"sourceSha256",
		"maxSkillChoices",
		"maxPerkChoices",
		"maxPerksPerSkill",
		"skills"
	],
	"oneOf": [
		{
			"required": ["commandPolicyVersion"],
			"not": {"anyOf": [{"required": ["commandAuthorityPolicy"]}, {"required": ["warfarePolicyVersion"]}]},
			"properties": {
				"skills": {"minProperties": 31, "maxProperties": 31, "not": {"required": ["new-horizons:authority"]}},
				"necromancyPolicy": {"not": {"properties": {"version": {"enum": [3]}}}}
			}
		},
		{
			"required": ["commandAuthorityPolicy", "warfarePolicyVersion", "necromancyPolicy"],
			"not": {"required": ["commandPolicyVersion"]},
			"properties": {
				"skills": {"minProperties": 32, "maxProperties": 32, "required": ["new-horizons:authority"]},
				"necromancyPolicy": {"properties": {"version": {"enum": [3]}}}
			}
		}
	],
	"properties": {
		"commandAuthorityPolicy": {"$ref": "#/definitions/commandAuthorityPolicy"},
		"warfarePolicyVersion": {"type": "integer", "enum": [1]},
		"elementalAttunementPolicy": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"type": "integer", "enum": [1]}}, "description": "Current deterministic Conflux Attunement and revised perk meanings; a full active registry requires version 1."},
		"commandPolicyVersion": {"type": "integer", "enum": [1], "description": "Current finite-Command perk meanings; a full active registry must carry version 1."},
		"metamagicPolicy": {"$ref": "#/definitions/metamagicPolicyV3"},
		"divineMandatePolicy": {"$ref": "#/definitions/passiveFactionSkillPolicyV2"},
		"demonicGatingPolicy": {"$ref": "#/definitions/passiveFactionSkillPolicyV2"},
		"bloodragePolicy": {"$ref": "#/definitions/passiveFactionSkillPolicyV2"},
		"connoisseurPolicy": {
			"type": "object", "additionalProperties": false,
			"required": ["version"],
			"properties": {"version": {"type": "integer", "enum": [1]}}
		},
		"schemaVersion": {"type": "integer", "enum": [1]},
		"rulesetVersion": {"type": "integer", "enum": [1, 2]},
		"offerWeightPolicyVersion": {"type": "integer", "enum": [1, 2], "description": "Captured weighting:1 full per-perk raw weights;2 normalized parent-first offers. Without an independent progression marker,2 retains historical same-tier selections."},
		"perkProgressionPolicyVersion": {"type": "integer", "enum": [1], "not": {"type": "null"}, "description": "Captured1 requires weight policy2 and permits only the next missing perk tier, one perk per tier and one offered alternative per parent. Absence preserves historical progression."},
		"sylvanTacticsPolicy": {"type": "integer", "enum": [1], "not": {"type": "null"}, "description": "Captured1 selects Sylvan Tactics rank/perk rules. Absence preserves historical Sylvan Luck definitions and effects; do not inject installed defaults into an old capture."},
		"necromancyPolicy": {"$ref": "#/definitions/necromancyPolicy"},
		"perkOfferNormalization": {
			"type": "object", "not": {"type": "null"}, "additionalProperties": false,
			"minProperties": 2, "maxProperties": 2,
			"required": ["maximumPreferenceRatio", "mathVersion"],
			"properties": {
				"maximumPreferenceRatio": {"type": "number", "minimum": 1, "not": {"type": "null"}},
				"mathVersion": {"type": "integer", "enum": [1], "not": {"type": "null"}}
			}
		},
		"sourceDocument": {"type": "string", "minLength": 1},
		"sourceSha256": {"type": "string", "minLength": 64, "maxLength": 64},
		"maxSkillChoices": {"type": "integer", "enum": [2]},
		"maxPerkChoices": {"type": "integer", "enum": [2]},
		"maxPerksPerSkill": {"type": "integer", "enum": [3]},
		"skills": {
			"type": "object",
			"minProperties": 31,
			"maxProperties": 32,
			"additionalProperties": {"$ref": "#/definitions/skill"},
			"properties": {
				"new-horizons:discipline": {
					"type": "object",
					"required": ["id", "name", "domain", "availability", "description", "ranks", "perks"],
					"additionalProperties": false,
					"properties": {
						"id": {"enum": ["new-horizons:discipline"]},
						"name": {"type": "string", "minLength": 1},
						"domain": {"type": "string", "enum": ["Martial", "Magic", "Hybrid", "Strategic", "Faction"]},
						"availability": {
							"type": "string",
							"enum": [
								"All heroes",
								"Might-exclusive",
								"Magic-exclusive",
								"Castle heroes only",
								"Rampart heroes only",
								"Tower heroes only",
								"Dungeon heroes only",
								"Inferno heroes only",
								"Necropolis heroes only",
								"Stronghold heroes only",
								"Fortress heroes only",
								"Conflux heroes only"
							]
