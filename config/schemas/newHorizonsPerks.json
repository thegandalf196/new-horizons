							"minItems": 10,
							"maxItems": 10,
							"items": {
								"oneOf": [
									{
										"type": "object",
										"required": ["id", "name", "requires", "description", "effect"],
										"additionalProperties": false,
										"properties": {
											"id": {"enum": ["new-horizons:chaosMagic.mindbreaker"]},
											"name": {"type": "string", "minLength": 1},
											"requires": {"type": "string", "enum": ["basic", "advanced", "expert"]},
											"description": {"type": "string", "minLength": 1},
											"details": {"type": "string", "minLength": 1},
