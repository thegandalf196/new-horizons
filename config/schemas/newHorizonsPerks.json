												"required": ["version", "operations"],
												"properties": {
													"version": {"type": "integer", "enum": [1]},
													"operations": {
														"type": "array",
														"minItems": 1,
														"maxItems": 1,
														"items": {
															"type": "object",
															"additionalProperties": false,
															"required": ["operation", "source", "target", "stage", "lifetime"],
															"properties": {
																"operation": {"enum": ["creatureSuppression"]},
																"source": {"enum": ["spellAddition"]},
																"target": {"enum": ["spellRecipient"]},
																"stage": {"enum": ["castApplication"]},
																"lifetime": {"enum": ["rounds"]}
															}
														}
													}
												}
											}
										}
									},
									{
										"type": "object",
										"required": ["id", "name", "requires", "description", "effect"],
										"additionalProperties": false,
										"properties": {
											"id": {"type": "string", "minLength": 1},
											"name": {"type": "string", "minLength": 1},
											"requires": {"type": "string", "enum": ["basic", "advanced", "expert"]},
											"description": {"type": "string", "minLength": 1},
											"details": {"type": "string", "minLength": 1},
											"effect": {"$ref": "#/definitions/effect"}
										},
										"not": {"required": ["id"], "properties": {"id": {"enum": ["new-horizons:chaosMagic.mindbreaker"]}}}
									}
								]
							}
						}
					}
				},
				"new-horizons:luck": {
