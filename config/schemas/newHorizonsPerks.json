									}
								},
								"advanced": {
									"type": "object",
									"required": ["description", "effect"],
									"additionalProperties": false,
									"properties": {
										"description": {"type": "string", "minLength": 1},
										"details": {"type": "string", "minLength": 1},
										"effect": {"$ref": "#/definitions/effect"},
										"mechanics": {"$ref": "#/definitions/preparedRankMechanicsV1"}
									}
								},
								"expert": {
									"type": "object",
									"required": ["description", "effect"],
									"additionalProperties": false,
									"properties": {
										"description": {"type": "string", "minLength": 1},
										"details": {"type": "string", "minLength": 1},
										"effect": {"$ref": "#/definitions/effect"},
										"mechanics": {"$ref": "#/definitions/preparedRankMechanicsV1"}
									}
								}
							}
						},
						"perks": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/definitions/perk"}}
					}
