{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"title": "New Horizons generic Skills and perks",
	"description": "Captured Skills and ten-perk pools: Command/Authority policy 1 requires 32 Skills; historical absence retains 31. Planned effects are not active runtime behavior.",
	"type": "object",
	"additionalProperties": false,
	"dependencies": {
		"fourOfferProgressionVersion": {
			"required": ["perkProgressionPolicyVersion", "offerWeightPolicyVersion"],
			"not": {"required": ["unifiedSkillProgressionVersion"]},
			"properties": {"perkProgressionPolicyVersion": {"enum": [1, 2]}, "offerWeightPolicyVersion": {"enum": [2]}}
		},
		"estatesPolicyVersion": {
			"properties": {
				"skills": {"properties": {"new-horizons:estates": {"properties": {
					"perks": {"items": {"oneOf": [
						{"properties": {"id": {"enum": ["new-horizons:estates.taxCollector"]}, "requires": {"enum": ["basic"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.supervisor"]}, "requires": {"enum": ["basic"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.mercenaryCompany"]}, "requires": {"enum": ["basic"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.merchantPrince"]}, "requires": {"enum": ["basic"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.stewardship"]}, "requires": {"enum": ["advanced"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.conscription"]}, "requires": {"enum": ["advanced"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.architect"]}, "requires": {"enum": ["advanced"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.hoarder"]}, "requires": {"enum": ["advanced"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.decentralization"]}, "requires": {"enum": ["expert"]}}},
						{"properties": {"id": {"enum": ["new-horizons:estates.alchemist"]}, "requires": {"enum": ["expert"]}}}
					]}}
				}}}}
			}
		},
		"unifiedSkillProgressionVersion": {
			"required": ["perkProgressionPolicyVersion", "offerWeightPolicyVersion", "necromancyPolicy"],
			"properties": {"perkProgressionPolicyVersion": {"enum": [1, 2]}, "offerWeightPolicyVersion": {"enum": [2]}, "necromancyPolicy": {"properties": {"version": {"enum": [4]}}}}
		},
		"perkProgressionPolicyVersion": {
			"properties": {"offerWeightPolicyVersion": {"enum": [2]}},
			"dependencies": {"perkProgressionPolicyVersion": ["offerWeightPolicyVersion", "perkOfferNormalization"]}
		}
	},
	"required": [
		"schemaVersion",
		"rulesetVersion",
		"elementalAttunementPolicy",
		"sourceDocument",
		"sourceSha256",
		"maxSkillChoices",
		"maxPerkChoices",
		"maxPerksPerSkill",
		"skills"
	],
	"oneOf": [
		{
			"required": ["commandPolicyVersion"],
			"not": {"anyOf": [{"required": ["commandAuthorityPolicy"]}, {"required": ["warfarePolicyVersion"]}]},
			"properties": {
				"skills": {"minProperties": 31, "maxProperties": 31, "not": {"required": ["new-horizons:authority"]}},
				"necromancyPolicy": {"not": {"properties": {"version": {"enum": [3]}}}}
			}
		},
		{
			"required": ["commandAuthorityPolicy", "warfarePolicyVersion", "necromancyPolicy"],
			"not": {"required": ["commandPolicyVersion"]},
			"properties": {
				"skills": {"minProperties": 32, "maxProperties": 32, "required": ["new-horizons:authority"]},
				"necromancyPolicy": {"properties": {"version": {"enum": [2, 3, 4]}}}
			}
		}
	],
	"properties": {
		"fourOfferProgressionVersion": {"type": "integer", "enum": [1], "description": "Four fixed weighted groups offer a Skill or a perk using raw class weights. Perk progression policy 2 requires one Basic, one Advanced and one Expert perk in order. Historical policy 1 retains its original tier eligibility."},
		"spellcraftPolicyVersion": {"type": "integer", "enum": [2], "description": "Captured2 makes Precise Casting halve the target's resistance chance; absence retains the historical friendly area-centre protection."},
		"estatesPolicyVersion": {"type": "integer", "enum": [1], "description": "Revised Estates catalogue and captured economy effects; absence retains the entire historical catalogue and effects."},
		"commandAuthorityPolicy": {"$ref": "#/definitions/commandAuthorityPolicy"},
		"warfarePolicyVersion": {"type": "integer", "enum": [1]},
		"unifiedSkillProgressionVersion": {"type": "integer", "enum": [1], "description": "One full eligible tier choice immediately follows every acquired Skill rank. Historical random perk-offer limits do not truncate that pool."},
		"elementalAttunementPolicy": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"type": "integer", "enum": [1]}}, "description": "Current deterministic Conflux Attunement and revised perk meanings; a full active registry requires version 1."},
		"commandPolicyVersion": {"type": "integer", "enum": [1], "description": "Current finite-Command perk meanings; a full active registry must carry version 1."},
		"metamagicPolicy": {
			"oneOf": [{"$ref": "#/definitions/metamagicPolicyV3"}, {"$ref": "#/definitions/metamagicPolicyV4"}, {"$ref": "#/definitions/metamagicPolicyV5"}, {"$ref": "#/definitions/metamagicPolicyV6"}, {"$ref": "#/definitions/metamagicPolicyV7"}]
		},
		"divineMandatePolicy": {
			"oneOf": [{"$ref": "#/definitions/passiveFactionSkillPolicyV2"}, {"$ref": "#/definitions/consecratedArmsPolicyV3"}, {"$ref": "#/definitions/consecratedArmsPolicyV4"}]
		},
		"demonicGatingPolicy": {"$ref": "#/definitions/passiveFactionSkillPolicyV2"},
		"bloodragePolicy": {"$ref": "#/definitions/passiveFactionSkillPolicyV2"},
		"connoisseurPolicy": {
			"type": "object", "additionalProperties": false,
			"required": ["version"],
			"properties": {"version": {"type": "integer", "enum": [1]}}
		},
		"schemaVersion": {"type": "integer", "enum": [1]},
		"rulesetVersion": {"type": "integer", "enum": [1, 2]},
		"offerWeightPolicyVersion": {"type": "integer", "enum": [1, 2], "description": "Captured weighting:1 full per-perk raw weights;2 normalized parent-first offers. Without an independent progression marker,2 retains historical same-tier selections."},
		"perkProgressionPolicyVersion": {"type": "integer", "enum": [1, 2], "not": {"type": "null"}, "description": "Captured1 preserves historical four-offer eligibility. Captured2 requires exactly one Basic, Advanced and Expert perk in order, including four-offer choices. Both require weight policy2 and one offered alternative per parent. Absence preserves historical progression."},
		"sylvanTacticsPolicy": {"type": "integer", "enum": [1, 2, 3, 4], "not": {"type": "null"}, "description": "Captured1 retains the movement/Waiting Sylvan Tactics pool;2 selects the Rampart creature-family pool;3 selects the mixed tactical pool;4 keeps that roster with revised Dappled Cover, Quick Redeployment and Hunting Pack effects. Absence preserves historical Sylvan Luck definitions and effects; never inject installed defaults into an old capture."},
		"necromancyPolicy": {"$ref": "#/definitions/necromancyPolicy"},
		"perkOfferNormalization": {
			"type": "object", "not": {"type": "null"}, "additionalProperties": false,
			"minProperties": 2, "maxProperties": 2,
			"required": ["maximumPreferenceRatio", "mathVersion"],
			"properties": {
				"maximumPreferenceRatio": {"type": "number", "minimum": 1, "not": {"type": "null"}},
				"mathVersion": {"type": "integer", "enum": [1], "not": {"type": "null"}}
			}
		},
		"sourceDocument": {"type": "string", "minLength": 1},
		"sourceSha256": {"type": "string", "minLength": 64, "maxLength": 64},
		"maxSkillChoices": {"type": "integer", "enum": [2]},
		"maxPerkChoices": {"type": "integer", "enum": [2]},
		"maxPerksPerSkill": {"type": "integer", "enum": [3]},
		"skills": {
