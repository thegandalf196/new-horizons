{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons six-school magic rules",
	"description": "Empty object retains legacy magic. Registration, complete common-hero-spell coverage, memberships and scoped skill identities are also checked by the runtime validator. Provisional mappings and costs are versioned, not global spell patches.",
	"type": "object",
	"oneOf": [
		{
			"maxProperties": 0
		},
		{
			"minProperties": 6,
			"required": [
				"schemaVersion",
				"rulesetVersion",
				"schools",
				"spells",
				"schoolSkills",
				"skillReplacements"
			],
			"additionalProperties": false,
			"properties": {
				"schemaVersion": {
					"type": "integer",
					"enum": [
						1
					]
				},
				"rulesetVersion": {
					"type": "integer",
					"enum": [
						1
					]
				},
				"schools": {
					"type": "array",
					"minItems": 6,
					"maxItems": 6,
					"uniqueItems": true,
					"items": {
						"$ref": "#/definitions/school"
					}
				},
				"spells": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": false,
					"patternProperties": {
						"^[a-zA-Z0-9_.-]+:[a-zA-Z0-9_.-]+$": {
							"$ref": "#/definitions/spell"
						}
					}
				},
				"schoolSkills": {
					"type": "object",
					"minProperties": 6,
					"required": [
						"new-horizons:light",
						"new-horizons:nature",
						"new-horizons:sorcery",
						"new-horizons:havoc",
						"new-horizons:shadow",
						"new-horizons:chaos"
					],
					"additionalProperties": false,
					"properties": {
						"new-horizons:light": {
							"type": "string",
							"enum": [
								"new-horizons:lightMagic"
							]
						},
						"new-horizons:nature": {
							"type": "string",
							"enum": [
								"new-horizons:natureMagic"
							]
						},
						"new-horizons:sorcery": {
							"type": "string",
							"enum": [
								"new-horizons:sorceryMagic"
							]
						},
						"new-horizons:havoc": {
							"type": "string",
							"enum": [
								"new-horizons:havocMagic"
							]
						},
						"new-horizons:shadow": {
							"type": "string",
							"enum": [
								"new-horizons:shadowMagic"
							]
						},
						"new-horizons:chaos": {
							"type": "string",
							"enum": [
								"new-horizons:chaosMagic"
							]
						}
					}
				},
				"skillReplacements": {
					"type": "object",
					"minProperties": 4,
					"required": [
						"core:airMagic",
						"core:fireMagic",
						"core:waterMagic",
						"core:earthMagic"
					],
					"additionalProperties": false,
					"properties": {
						"core:airMagic": {
							"type": "string",
							"enum": [
								"new-horizons:sorceryMagic"
							]
						},
						"core:fireMagic": {
							"type": "string",
							"enum": [
								"new-horizons:havocMagic"
							]
						},
						"core:waterMagic": {
							"type": "string",
							"enum": [
								"new-horizons:lightMagic"
							]
						},
						"core:earthMagic": {
							"type": "string",
							"enum": [
								"new-horizons:natureMagic"
							]
						}
					}
				},
				"factions": {
					"type": "object",
					"additionalProperties": false,
					"patternProperties": {
						"^[a-zA-Z0-9_.-]+:[a-zA-Z0-9_.-]+$": {
							"$ref": "#/definitions/faction"
						}
					}
				},
				"factionWeights": {
					"type": "object",
					"minProperties": 2,
					"required": [
						"major",
						"minor"
					],
					"additionalProperties": false,
					"properties": {
						"major": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1000
						},
						"minor": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1000
						}
					}
				}
			},
			"dependencies": {
				"schemaVersion": [
					"rulesetVersion",
					"schools",
					"spells",
					"schoolSkills",
					"skillReplacements"
				],
				"factions": [
					"schemaVersion",
					"rulesetVersion",
					"schools",
					"spells",
					"schoolSkills",
					"skillReplacements"
				],
				"factionWeights": [
					"schemaVersion",
					"rulesetVersion",
					"schools",
					"spells",
					"schoolSkills",
					"skillReplacements"
				]
			}
		}
	],
	"definitions": {
		"school": {
			"type": "string",
			"enum": [
				"new-horizons:light",
				"new-horizons:nature",
				"new-horizons:sorcery",
				"new-horizons:havoc",
				"new-horizons:shadow",
				"new-horizons:chaos"
			]
		},
		"spell": {
			"type": "object",
			"minProperties": 1,
			"required": [
				"schools"
			],
			"additionalProperties": false,
			"properties": {
				"schools": {
					"type": "array",
					"minItems": 1,
					"maxItems": 6,
					"uniqueItems": true,
					"items": {
						"$ref": "#/definitions/school"
					}
				},
				"level": {
					"type": "integer",
					"minimum": 1,
					"maximum": 5
				},
				"costs": {
					"type": "array",
					"minItems": 4,
					"maxItems": 4,
					"items": {
						"type": "integer",
						"minimum": 0,
						"maximum": 1000000
					}
				}
			},
			"dependencies": {
				"level": [
					"schools"
				],
				"costs": [
					"schools"
				]
			}
		},
		"faction": {
			"type": "object",
			"minProperties": 2,
			"required": [
				"major",
				"minor"
			],
			"additionalProperties": false,
			"properties": {
				"major": {
					"$ref": "#/definitions/school"
				},
				"minor": {
					"$ref": "#/definitions/school"
				},
				"provisional": {
					"type": "boolean"
				}
			},
			"dependencies": {
				"major": [
					"minor"
				],
				"minor": [
					"major"
				],
				"provisional": [
					"major",
					"minor"
				]
			}
		}
	}
}
