{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons hero growth and scale rules",
	"description": "New Horizons hero growth, canonical skill-offer weights, and starting-skill schema. Empty retains legacy heroes. Runtime additionally checks scoped identifiers, complete new-game class coverage, growth sum ten, first chance zero, profile bounds against maxPrimary, complete per-class offer coverage, removed-skill exclusions, faction-skill coverage and saved identity preservation.",
	"type": "object",
	"oneOf": [
		{"maxProperties": 0},
		{
			"minProperties": 6,
			"required": ["schemaVersion", "rulesetVersion", "powerDivisor", "maxPrimary", "classProfiles", "extraGrowth"],
			"additionalProperties": false,
			"properties": {
				"schemaVersion": {"type": "integer", "enum": [1]},
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"powerDivisor": {"type": "integer", "minimum": 1, "maximum": 1000},
				"maxPrimary": {"type": "integer", "minimum": 100, "maximum": 1000000},
				"classProfiles": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/profile"}
				},
				"skillOfferWeights": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/skillOfferWeights"}
				},
				"excludedSkills": {
					"type": "array",
					"uniqueItems": true,
					"items": {"type": "string", "minLength": 1}
				},
				"extraGrowth": {"type": "array", "items": {"$ref": "#/definitions/extra"}},
				"startingSkills": {"$ref": "#/definitions/startingSkills"}
			}
		}
	],
	"definitions": {
		"profile": {
			"type": "object",
			"required": ["starting", "growth"],
			"additionalProperties": false,
			"properties": {
				"starting": {
					"type": "array", "minItems": 4, "maxItems": 4,
					"items": {"type": "integer", "minimum": 0, "maximum": 1000000}
				},
				"growth": {
					"type": "array", "minItems": 4, "maxItems": 4,
					"items": {"type": "integer", "minimum": 1, "maximum": 10}
				}
			}
		},
		"skillOfferWeights": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
		},
		"extra": {
			"type": "object",
			"required": ["skill", "primary", "chances"],
			"additionalProperties": false,
			"properties": {
				"skill": {"type": "string", "minLength": 1},
				"primary": {"type": "integer", "minimum": 0, "maximum": 3},
				"chances": {
					"type": "array", "minItems": 4, "maxItems": 4,
					"items": {"type": "integer", "minimum": 0, "maximum": 100}
				}
			}
		},
		"startingSkills": {
			"type": "object",
			"additionalProperties": false,
			"required": ["factionSkills", "legacyAliases", "magic", "might"],
			"properties": {
				"factionSkills": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"type": "string", "minLength": 1}
				},
				"legacyAliases": {
					"type": "object",
					"additionalProperties": {"type": "string", "minLength": 1}
				},
				"legacySkillMigrations": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/startingSkillMigration"}
				},
				"magic": {
					"type": "object",
					"additionalProperties": false,
					"required": ["replace"],
					"properties": {
						"replace": {"type": "string", "minLength": 1}
					}
				},
				"might": {
					"type": "object",
					"additionalProperties": false,
					"required": ["replacePosition", "singleSkillFallback"],
					"properties": {
						"replacePosition": {"type": "string", "enum": ["second"]},
						"singleSkillFallback": {"type": "string", "enum": ["append", "replaceFirst"]}
					}
				}
			}
		},
		"startingSkillMigration": {
			"type": "object",
			"required": ["kind", "target"],
			"additionalProperties": false,
			"properties": {
				"kind": {"type": "string", "enum": ["skill", "factionSkill", "perk"]},
				"target": {"type": "string", "minLength": 1},
				"fallback": {"type": "string", "enum": ["remove"]}
			}
		}
	}
}
