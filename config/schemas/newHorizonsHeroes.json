{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons hero growth and scale rules",
	"description": "New Horizons hero growth, canonical skill-offer weights, starting-skill schema, and optional versioned creature-line, damage-spell, non-damage-spell, Logistics, and Armorer specialty conversions. Primary growth grants the fixed class vector on every level; version 3 additionally evaluates independent configured skill bonus rolls. Empty retains legacy heroes.",
	"type": "object",
	"oneOf": [
		{"maxProperties": 0},
		{
			"minProperties": 6,
			"required": ["schemaVersion", "rulesetVersion", "powerDivisor", "maxPrimary", "classProfiles", "extraGrowth"],
			"additionalProperties": false,
			"properties": {
				"lighthouseDeparture": {
					"type": "object", "additionalProperties": false,
					"required": ["enabled", "seaMovementPercent"],
					"properties": {"enabled": {"type": "boolean"}, "seaMovementPercent": {"type": "integer", "minimum": 1, "maximum": 100}}
				},
				"defaultCreatureLineReplacements": {
					"type": "object", "additionalProperties": false,
					"required": ["core:pasis", "core:monere"],
					"properties": {
						"core:pasis": {"enum": ["new-horizons:wisp"]},
						"core:monere": {"enum": ["new-horizons:wisp"]}
					}
				},
				"schemaVersion": {"type": "integer", "enum": [1]},
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"powerDivisor": {"type": "integer", "minimum": 1, "maximum": 1000},
				"maxPrimary": {"type": "integer", "minimum": 100, "maximum": 1000000},
				"classProfiles": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/profile"}
				},
				"skillOfferWeights": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/skillOfferWeights"}
				},
				"excludedSkills": {
					"type": "array",
					"uniqueItems": true,
					"items": {"type": "string", "minLength": 1}
				},
				"extraGrowth": {
					"description": "Independent skill-based primary bonus chances by rank for version 3 profiles. Older profiles ignore these rows.",
					"type": "array", "items": {"$ref": "#/definitions/extra"}
				},
				"startingSkills": {"$ref": "#/definitions/startingSkills"},
				"creatureLineSpecialties": {"$ref": "#/definitions/creatureLineSpecialties"},
				"damageSpellSpecialties": {"$ref": "#/definitions/damageSpellSpecialties"},
				"nonDamageSpellSpecialties": {"$ref": "#/definitions/nonDamageSpellSpecialties"},
				"chosenSpecialties": {
					"type": "object", "additionalProperties": false,
					"required": ["version", "inteusDurationBonus", "loynisManaDiscountPercent"],
					"properties": {
						"version": {"enum": [1]},
						"inteusDurationBonus": {"type": "integer", "minimum": 0, "maximum": 100},
						"loynisManaDiscountPercent": {"type": "integer", "minimum": 0, "maximum": 100}
					}
				},
				"skillSpecialties": {"$ref": "#/definitions/skillSpecialties"},
				"schoolSpellcraftSpecialties": {"$ref": "#/definitions/schoolSpellcraftSpecialties"},
				"additionalSpecialties": {"$ref": "#/definitions/additionalSpecialties"},
				"recoverySpecialties": {"$ref": "#/definitions/recoverySpecialties"},
				"reclamationSpecialty": {"$ref": "#/definitions/reclamationSpecialty"},
				"ghostSpecialty": {"$ref": "#/definitions/ghostSpecialty"},
				"petrifyingBloodSpecialty": {"$ref": "#/definitions/petrifyingBloodSpecialty"},
				"livingInfernoSpecialty": {"$ref": "#/definitions/livingInfernoSpecialty"},
				"dreadCavalrySpecialty": {"$ref": "#/definitions/dreadCavalrySpecialty"},
				"genieSageSpecialties": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"enum": [1]}}},
				"swampSeerSpecialty": {"$ref": "#/definitions/swampSeerSpecialty"},
				"learningExchangeSpecialties": {"$ref": "#/definitions/learningExchangeSpecialties"},
				"individualSpecialties": {"$ref": "#/definitions/individualSpecialties"},
				"druidSpecialties": {"$ref": "#/definitions/druidSpecialties"},
				"fortuneChildSpecialty": {
					"type": "object", "additionalProperties": false,
					"required": ["version", "luckPerStep", "levelStep"],
					"properties": {
						"version": {"type": "integer", "enum": [1]},
						"luckPerStep": {"type": "integer", "minimum": 0, "maximum": 1000},
						"levelStep": {"type": "integer", "minimum": 1, "maximum": 1000}
					}
				},
				"masterSpellwardSpecialty": {
					"type": "object", "additionalProperties": false,
					"not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["version", "percentPerLevel", "maximumExtraPercent"],
					"properties": {
						"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
						"percentPerLevel": {"type": "integer", "minimum": 0, "maximum": 100, "not": {"type": "null"}},
						"maximumExtraPercent": {"type": "integer", "minimum": 0, "maximum": 100, "not": {"type": "null"}}
					}
				},
				"bottomlessMindSpecialty": {
					"type": "object", "additionalProperties": false,
					"not": {"type": "null"},
					"minProperties": 2, "maxProperties": 2,
					"required": ["version", "pointsPerLevel"],
					"properties": {
						"version": {"type": "integer", "enum": [1]},
						"pointsPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000000, "not": {"type": "null"}}
					}
				},
				"arcanePreparationSpecialty": {
					"type": "object", "additionalProperties": false,
					"required": ["version", "initialPercent", "percentPerLevel", "maximumPercent"],
					"properties": {
						"version": {"type": "integer", "enum": [1]},
						"initialPercent": {"type": "integer", "minimum": 0, "maximum": 100},
						"percentPerLevel": {"type": "integer", "minimum": 0, "maximum": 100},
						"maximumPercent": {"type": "integer", "minimum": 0, "maximum": 100}
					}
				},
				"remainingSpellSpecialtyReplacements": {"type": "boolean", "description": "Captured six authored spell-specialty successors. Absence or false preserves original producers; any key presence requires its serialization feature."}
			}
		}
	],
	"definitions": {
		"schoolSpellcraftSpecialties": {
			"description": "Optional captured school-scoped Spellcraft specialties. Absence preserves the prior context; coefficients are provisional balance values.",
			"type": "object", "additionalProperties": false, "not": {"type": "null"},
			"minProperties": 5, "maxProperties": 5,
			"required": ["version", "overcaster", "darkSavant", "primalFormula", "mireHexer"],
			"properties": {
				"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
				"overcaster": {"$ref": "#/definitions/schoolSpellcraftCoefficients"},
				"darkSavant": {"$ref": "#/definitions/schoolSpellcraftCoefficients"},
				"primalFormula": {"$ref": "#/definitions/schoolSpellcraftCoefficients"},
				"mireHexer": {"$ref": "#/definitions/schoolSpellcraftCoefficients"}
			}
		},
		"schoolSpellcraftCoefficients": {
			"type": "object", "additionalProperties": false, "not": {"type": "null"},
			"minProperties": 2, "maxProperties": 2,
			"required": ["percentPerLevel", "maximumPercent"],
			"properties": {
				"percentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
				"maximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}}
			}
		},
		"additionalSpecialties": {
			"description": "Optional captured additional individual specialties. Absent rows preserve prior behavior; coefficients are provisional balance values.",
			"type": "object", "additionalProperties": false, "not": {"type": "null"},
			"minProperties": 1, "maxProperties": 11,
			"required": ["version"],
			"properties": {
				"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
				"ordinaryCreatureSpecialties": {
 "type": "object", "additionalProperties": false,
 "required": ["version", "closeQuartersDrill", "marshSharpshooter", "retaliationDamagePercent", "defendDefense", "maximumHealthPercent", "resistanceAuraPoints"],
 "dependencies": {
 "gunneryProfessorInitiativeFlat": ["gunneryProfessorFollowUpBonusPoints"],
 "gunneryProfessorFollowUpBonusPoints": ["gunneryProfessorInitiativeFlat"]
 },
 "properties": {
 "version": {"type": "integer", "enum": [1]},
 "closeQuartersDrill": {"type": "integer", "enum": [1]},
 "marshSharpshooter": {"type": "integer", "enum": [1]},
 "retaliationDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "defendDefense": {"type": "integer", "minimum": 0, "maximum": 100},
 "maximumHealthPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "resistanceAuraPoints": {"type": "integer", "minimum": 0, "maximum": 100},
 "massedSpearsDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "packPursuitDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "bloodScentDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "livingBastionDefense": {"type": "integer", "minimum": 0, "maximum": 100},
 "chillingPresenceReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "boneFormationDefense": {"type": "integer", "minimum": 0, "maximum": 100},
 "stoneSentinelReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "ogreWarcallerDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "undertowRetaliationPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "wyvernsPreyDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "mobPressureDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "wingbeatInitiativePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "measuredVolleyMdrPenetrationPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "prismaticScreenReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "evasiveFlightReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "ridersExploitDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "tidalRenewalHealingHP": {"type": "integer", "minimum": 0, "maximum": 100},
 "cruelVolleyDamagePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "rangefinderFullDamageDistance": {"type": "integer", "enum": [0, 12]},
 "fieldReassemblyHealingHP": {"type": "integer", "minimum": 0, "maximum": 100},
 "fieldMaintenanceHealingHP": {"type": "integer", "minimum": 0, "maximum": 100},
 "ogreBulwarkRetaliations": {"type": "integer", "enum": [0, 1]},
 "gunneryProfessorInitiativeFlat": {"type": "integer", "minimum": 0, "maximum": 100},
 "gunneryProfessorFollowUpBonusPoints": {"type": "integer", "minimum": 0, "maximum": 40},
 "heavyBatterySiegeTermBonusPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "shieldAndSwordPhysicalReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "sepulchralGripSpeedReduction": {"type": "integer", "minimum": 0, "maximum": 100},
 "cyclopeanBreachIgnorePercent": {"type": "integer", "minimum": 0, "maximum": 100},
 "runicEnduranceReductionPercent": {"type": "integer", "minimum": 0, "maximum": 100}
 }
 },
				"forestAmbush": {
					"type": "object",
					"additionalProperties": false,
					"required": ["enabled"],
					"properties": {"enabled": {"type": "boolean"}}
				},
				"aerialSupremacy": {
					"type": "object", "additionalProperties": false, "required": ["enabled"],
					"properties": {"enabled": {"type": "boolean"}}
				},
				"paralyzingGaze": {
					"type": "object", "additionalProperties": false, "required": ["enabled"],
					"properties": {"enabled": {"type": "boolean"}}
				},
				"serpentsEmbrace": {
					"type": "object", "additionalProperties": false, "required": ["enabled"],
					"properties": {"enabled": {"type": "boolean"}}
				},
				"manaLeeches": {
					"type": "object", "additionalProperties": false,
					"required": ["manaPerDamagingAttackSequence"],
					"properties": {"manaPerDamagingAttackSequence": {"type": "integer", "minimum": 0, "maximum": 1000}}
				},
				"fieldPhysician": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 2, "maxProperties": 2,
					"required": ["healingPercentPerLevel", "healingMaximumPercent"],
					"properties": {
						"healingPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"healingMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}}
					}
				},
				"manaFurnace": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 2, "maxProperties": 2,
					"required": ["restorePointsPerLevel", "maximumRestorePoints"],
					"properties": {
						"restorePointsPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"maximumRestorePoints": {"type": "integer", "minimum": 0, "maximum": 1000000, "not": {"type": "null"}}
					}
				},
				"graveArchivist": {
					"type": "object",
					"additionalProperties": false,
					"not": {
						"type": "null"
					},
					"minProperties": 3,
					"maxProperties": 3,
					"required": [
						"learningPercentPerLevel",
						"learningMaximumPercent",
						"additionalEagleEyeSpells"
					],
					"properties": {
						"learningPercentPerLevel": {
							"type": "integer",
							"minimum": 0,
							"maximum": 1000,
							"not": {
								"type": "null"
							}
						},
						"learningMaximumPercent": {
							"type": "integer",
							"minimum": 0,
							"maximum": 200,
							"not": {
								"type": "null"
							}
						},
						"additionalEagleEyeSpells": {
							"type": "integer",
							"minimum": 0,
							"maximum": 10,
							"not": {
								"type": "null"
							}
						}
					}
				},
				"spiritTeacher": {
					"type": "object",
					"additionalProperties": false,
					"not": {
						"type": "null"
					},
					"minProperties": 3,
					"maxProperties": 3,
					"required": [
						"learningPercentPerLevel",
						"learningMaximumPercent",
						"mentorExperiencePercent"
					],
					"properties": {
						"learningPercentPerLevel": {
							"type": "integer",
							"minimum": 0,
							"maximum": 1000,
							"not": {
								"type": "null"
							}
						},
						"learningMaximumPercent": {
							"type": "integer",
							"minimum": 0,
							"maximum": 200,
							"not": {
								"type": "null"
							}
						},
						"mentorExperiencePercent": {
							"type": "integer",
							"minimum": 0,
							"maximum": 1000,
							"not": {
								"type": "null"
							}
						}
					}
				}
			}
		},
		"recoverySpecialties": {
			"description": "Optional captured recovery and creature-healing specialties. Absent rows preserve prior behavior; coefficients are provisional balance values.",
			"type": "object", "additionalProperties": false, "not": {"type": "null"},
			"minProperties": 1, "maxProperties": 5,
			"required": ["version"],
			"properties": {
				"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
				"infernalWellspring": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["dailyPercentPerLevel", "dailyMaximumPercent", "victoryPercent"],
					"properties": {
						"dailyPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"dailyMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
						"victoryPercent": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}}
					}
				},
				"ritualReserve": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["dailyPercentPerLevel", "dailyMaximumPercent", "lowNormalPercent"],
					"properties": {
						"dailyPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"dailyMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
						"lowNormalPercent": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}}
					}
				},
				"deepTrance": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["dailyPercentPerLevel", "dailyMaximumPercent", "firstCombatPercent"],
					"properties": {
						"dailyPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"dailyMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
						"firstCombatPercent": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}}
					}
				},
				"herbalSurgeon": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 4, "maxProperties": 4,
					"required": ["tentPercentPerLevel", "tentMaximumPercent", "regenerationPercentPerLevel", "regenerationMaximumPercent"],
					"properties": {
						"tentPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"tentMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
						"regenerationPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"regenerationMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}}
					}
				}
			}
		},
		"learningExchangeSpecialties": {
			"description": "Optional captured directed Scholar-exchange and Learning-core specialties. Absent rows preserve prior behavior; coefficients are provisional balance values.",
			"type": "object", "additionalProperties": false, "not": {"type": "null"},
			"minProperties": 1, "maxProperties": 3,
			"required": ["version"],
			"properties": {
				"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
				"ecumenicalScholar": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["learningPercentPerLevel", "learningMaximumPercent", "additionalSpellsTaught"],
					"properties": {
						"learningPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"learningMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
						"additionalSpellsTaught": {"type": "integer", "minimum": 0, "maximum": 1, "not": {"type": "null"}}
					}
				},
				"occultScholar": {
					"type": "object", "additionalProperties": false, "not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["learningPercentPerLevel", "learningMaximumPercent", "additionalSpellsReceived"],
					"properties": {
						"learningPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
						"learningMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
						"additionalSpellsReceived": {"type": "integer", "minimum": 0, "maximum": 1, "not": {"type": "null"}}
					}
				}
			}
		},
		"swampSeerSpecialty": {
			"description": "Optional captured Learning-core and magical-study specialty. Absence preserves prior behavior; coefficients are provisional balance values.",
			"type": "object", "additionalProperties": false, "not": {"type": "null"},
