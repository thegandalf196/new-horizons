{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons hero growth and scale rules",
	"description": "New Horizons hero growth, canonical skill-offer weights, starting-skill schema, and optional versioned creature-line, damage-spell, non-damage-spell, Logistics, and Armorer specialty conversions. Primary growth grants the fixed class vector on every level; version 3 additionally evaluates independent configured skill bonus rolls. Empty retains legacy heroes.",
	"type": "object",
	"oneOf": [
		{"maxProperties": 0},
		{
			"minProperties": 6,
			"required": ["schemaVersion", "rulesetVersion", "powerDivisor", "maxPrimary", "classProfiles", "extraGrowth"],
			"additionalProperties": false,
			"properties": {
				"schemaVersion": {"type": "integer", "enum": [1]},
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"powerDivisor": {"type": "integer", "minimum": 1, "maximum": 1000},
				"maxPrimary": {"type": "integer", "minimum": 100, "maximum": 1000000},
				"classProfiles": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/profile"}
				},
				"skillOfferWeights": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/skillOfferWeights"}
				},
				"excludedSkills": {
					"type": "array",
					"uniqueItems": true,
					"items": {"type": "string", "minLength": 1}
				},
				"extraGrowth": {
					"description": "Independent skill-based primary bonus chances by rank for version 3 profiles. Older profiles ignore these rows.",
					"type": "array", "items": {"$ref": "#/definitions/extra"}
				},
				"startingSkills": {"$ref": "#/definitions/startingSkills"},
				"creatureLineSpecialties": {"$ref": "#/definitions/creatureLineSpecialties"},
				"damageSpellSpecialties": {"$ref": "#/definitions/damageSpellSpecialties"},
				"nonDamageSpellSpecialties": {"$ref": "#/definitions/nonDamageSpellSpecialties"},
				"skillSpecialties": {"$ref": "#/definitions/skillSpecialties"}
			}
		}
	],
	"definitions": {
		"profile": {
			"type": "object",
			"required": ["starting", "growth"],
			"additionalProperties": false,
			"properties": {
				"progressionVersion": {
					"description": "Absent or 1 preserves ten-point growth times (level+4). Version 2 requires starting total 100 and growth total 18. Version 3 requires growth total 20 and each starting attribute equal to five times its growth. Cross-field constraints are checked at runtime.",
					"type": "integer", "enum": [1, 2, 3]
				},
				"starting": {
					"type": "array", "minItems": 4, "maxItems": 4,
					"items": {"type": "integer", "minimum": 0, "maximum": 1000000}
				},
				"growth": {
					"type": "array", "minItems": 4, "maxItems": 4,
					"items": {"type": "integer", "minimum": 1, "maximum": 20}
				}
			}
		},
		"skillOfferWeights": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {"type": "integer", "minimum": 0, "maximum": 100}
		},
		"extra": {
			"type": "object",
			"required": ["skill", "primary", "chances"],
			"additionalProperties": false,
			"properties": {
				"skill": {"type": "string", "minLength": 1},
				"primary": {"type": "integer", "minimum": 0, "maximum": 3},
				"chances": {
					"type": "array", "minItems": 4, "maxItems": 4,
					"items": {"type": "integer", "minimum": 0, "maximum": 100}
				}
			}
		},
		"creatureLineSpecialties": {
			"type": "object",
			"required": ["version", "speed", "initiative", "attributePerStep", "levelStep", "attributeMaximum"],
			"additionalProperties": false,
			"properties": {
				"version": {"type": "integer", "enum": [1]},
				"speed": {"type": "integer", "enum": [1]},
				"initiative": {"type": "integer", "enum": [1]},
				"attributePerStep": {"type": "integer", "enum": [1]},
				"levelStep": {"type": "integer", "enum": [5]},
				"attributeMaximum": {"type": "integer", "enum": [6]}
			}
		},
		"damageSpellSpecialties": {
			"type": "object",
			"required": ["version", "componentPercent"],
			"additionalProperties": false,
			"properties": {
				"coroniusHolyWrathReplacement": {"type": "boolean", "description": "Absent or false preserves captured pre-Coronius Slayer specialty contexts."},
				"version": {"type": "integer", "enum": [1]},
				"componentPercent": {"type": "integer", "enum": [15]}
			}
		},
		"nonDamageSpellSpecialties": {
			"type": "object",
			"required": ["version", "componentPercent", "spells"],
			"additionalProperties": false,
			"properties": {
				"aenainFrailtyReplacement": {"type": "boolean", "description": "Absent or false preserves captured pre-Aenain Frailty contexts."},
				"version": {"type": "integer", "enum": [1]},
				"componentPercent": {"type": "integer", "enum": [20]},
				"defensiveStartReplacements": {"type": "boolean", "description": "Absent or false preserves pre-replacement Merist and Labetha specialty identities."},
				"offensiveStartReplacements": {"type": "boolean", "description": "Absent or false preserves pre-replacement Loynis and Zubin specialty identities."},
				"remainingStartReplacements": {"type": "boolean", "description": "Absent or false preserves pre-replacement Inteus and Halon starting inscriptions."},
				"spells": {
					"type": "array", "minItems": 1, "maxItems": 10,
					"uniqueItems": true,
					"items": {"type": "string", "enum": ["core:cure", "core:resurrection", "core:bless", "core:haste", "new-horizons:reanimate", "new-horizons:frailty", "new-horizons:hydrasVitality", "new-horizons:guardianSpirit", "new-horizons:crusade", "new-horizons:focusMagic"]}
				}
			}
		},
		"skillSpecialties": {
			"type": "object",
			"required": ["version", "coreBonusPercent", "skills"],
			"additionalProperties": false,
			"properties": {
				"version": {"type": "integer", "enum": [1]},
				"coreBonusPercent": {"type": "integer", "enum": [20]},
				"skills": {
					"type": "array", "minItems": 1, "maxItems": 5,
					"uniqueItems": true,
					"items": {"type": "string", "enum": ["core:logistics", "core:armorer", "core:offence", "core:archery", "core:estates"]}
				}
			}
		},
		"startingSkills": {
			"type": "object",
			"additionalProperties": false,
			"required": ["factionSkills", "legacyAliases", "magic", "might"],
			"properties": {
				"factionSkills": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"type": "string", "minLength": 1}
				},
				"legacyAliases": {
					"type": "object",
					"additionalProperties": {"type": "string", "minLength": 1}
				},
				"startingDevelopmentProfiles": {
					"description": "Optional captured profiles for fresh heroes using default Secondary Skills. Absent retains existing migration; explicit map rosters and saved/crossover heroes do not apply these profiles.",
					"type": "object",
					"additionalProperties": {"$ref": "#/definitions/startingDevelopmentProfile"}
				},
				"legacySkillMigrations": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/startingSkillMigration"}
				},
				"magic": {
					"type": "object",
					"additionalProperties": false,
					"required": ["replace"],
					"properties": {
						"replace": {"type": "string", "minLength": 1}
					}
				},
				"might": {
					"type": "object",
					"additionalProperties": false,
					"required": ["replacePosition", "singleSkillFallback"],
					"properties": {
						"replacePosition": {"type": "string", "enum": ["second"]},
						"singleSkillFallback": {"type": "string", "enum": ["append", "replaceFirst"]}
					}
				}
			}
		},
		"startingDevelopmentProfile": {
			"type": "object",
			"additionalProperties": false,
			"required": ["skills", "startingPerks"],
			"properties": {
				"skills": {
					"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
					"items": {
						"type": "object", "additionalProperties": false, "required": ["skill", "rank"],
						"properties": {
							"skill": {"type": "string", "pattern": "^new-horizons:[A-Za-z][A-Za-z0-9]*$"},
							"rank": {"type": "integer", "minimum": 1, "maximum": 2}
						}
					}
				},
				"startingPerks": {
					"type": "array", "minItems": 1, "maxItems": 1,
					"items": {
						"type": "object", "additionalProperties": false, "required": ["skill", "perk"],
						"properties": {
							"skill": {"type": "string", "pattern": "^new-horizons:[A-Za-z][A-Za-z0-9]*$"},
							"perk": {"type": "string", "pattern": "^new-horizons:[A-Za-z][A-Za-z0-9]*\\.[A-Za-z][A-Za-z0-9]*$"}
						}
					}
				}
			}
		},
		"startingSkillMigration": {
			"type": "object",
			"required": ["kind", "target"],
			"additionalProperties": false,
			"properties": {
				"kind": {"type": "string", "enum": ["skill", "factionSkill", "perk"]},
				"target": {"type": "string", "minLength": 1},
				"fallback": {"type": "string", "enum": ["remove"]}
			}
		}
	}
}
