{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons hero growth and scale rules",
	"description": "New Horizons hero growth, canonical skill-offer weights, starting-skill schema, and optional versioned creature-line, damage-spell, non-damage-spell, Logistics, and Armorer specialty conversions. Primary growth grants the fixed class vector on every level; version 3 additionally evaluates independent configured skill bonus rolls. Empty retains legacy heroes.",
	"type": "object",
	"oneOf": [
		{"maxProperties": 0},
		{
			"minProperties": 6,
			"required": ["schemaVersion", "rulesetVersion", "powerDivisor", "maxPrimary", "classProfiles", "extraGrowth"],
			"additionalProperties": false,
			"oneOf": [
				{
					"required": ["commandAuthorityPolicy", "skillOfferWeights"],
					"properties": {"skillOfferWeights": {"additionalProperties": {"minProperties": 32, "maxProperties": 32, "required": ["new-horizons:authority"], "properties": {"new-horizons:authority": {"type": "integer", "minimum": 1, "maximum": 100}}}}}
				},
				{
					"not": {"required": ["commandAuthorityPolicy"]},
					"properties": {"skillOfferWeights": {"additionalProperties": {"minProperties": 31, "maxProperties": 31, "not": {"required": ["new-horizons:authority"]}}}}
				}
			],
			"properties": {
				"commandAuthorityPolicy": {"$ref": "newHorizonsPerks.json#/definitions/commandAuthorityPolicy"},
				"lighthouseDeparture": {
					"type": "object", "additionalProperties": false,
					"required": ["enabled", "seaMovementPercent"],
					"properties": {"enabled": {"type": "boolean"}, "seaMovementPercent": {"type": "integer", "minimum": 1, "maximum": 100}}
				},
				"defaultCreatureLineReplacements": {
					"type": "object", "additionalProperties": false,
					"required": ["core:pasis", "core:monere"],
					"properties": {
						"core:pasis": {"enum": ["new-horizons:wisp"]},
						"core:monere": {"enum": ["new-horizons:wisp"]}
					}
				},
				"schemaVersion": {"type": "integer", "enum": [1]},
				"rulesetVersion": {"type": "integer", "enum": [1]},
				"powerDivisor": {"type": "integer", "minimum": 1, "maximum": 1000},
				"maxPrimary": {"type": "integer", "minimum": 100, "maximum": 1000000},
				"classProfiles": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/profile"}
				},
				"skillOfferWeights": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": {"$ref": "#/definitions/skillOfferWeights"}
				},
				"excludedSkills": {
					"type": "array",
					"uniqueItems": true,
					"items": {"type": "string", "minLength": 1}
				},
				"extraGrowth": {
					"description": "Independent skill-based primary bonus chances by rank for version 3 profiles. Older profiles ignore these rows.",
					"type": "array", "items": {"$ref": "#/definitions/extra"}
				},
				"startingSkills": {"$ref": "#/definitions/startingSkills"},
				"creatureLineSpecialties": {"$ref": "#/definitions/creatureLineSpecialties"},
				"damageSpellSpecialties": {"$ref": "#/definitions/damageSpellSpecialties"},
				"nonDamageSpellSpecialties": {"$ref": "#/definitions/nonDamageSpellSpecialties"},
				"chosenSpecialties": {
					"type": "object", "additionalProperties": false,
					"required": ["version", "inteusDurationBonus", "loynisManaDiscountPercent"],
					"properties": {
						"version": {"enum": [1]},
						"inteusDurationBonus": {"type": "integer", "minimum": 0, "maximum": 100},
						"loynisManaDiscountPercent": {"type": "integer", "minimum": 0, "maximum": 100}
					}
				},
				"skillSpecialties": {"$ref": "#/definitions/skillSpecialties"},
				"schoolSpellcraftSpecialties": {"$ref": "#/definitions/schoolSpellcraftSpecialties"},
				"additionalSpecialties": {"$ref": "#/definitions/additionalSpecialties"},
				"recoverySpecialties": {"$ref": "#/definitions/recoverySpecialties"},
				"reclamationSpecialty": {"$ref": "#/definitions/reclamationSpecialty"},
				"ghostSpecialty": {"$ref": "#/definitions/ghostSpecialty"},
				"petrifyingBloodSpecialty": {"$ref": "#/definitions/petrifyingBloodSpecialty"},
				"livingInfernoSpecialty": {"$ref": "#/definitions/livingInfernoSpecialty"},
				"dreadCavalrySpecialty": {"$ref": "#/definitions/dreadCavalrySpecialty"},
				"genieSageSpecialties": {"type": "object", "additionalProperties": false, "required": ["version"], "properties": {"version": {"enum": [1]}}},
				"swampSeerSpecialty": {"$ref": "#/definitions/swampSeerSpecialty"},
				"learningExchangeSpecialties": {"$ref": "#/definitions/learningExchangeSpecialties"},
				"individualSpecialties": {"$ref": "#/definitions/individualSpecialties"},
				"druidSpecialties": {"$ref": "#/definitions/druidSpecialties"},
				"fortuneChildSpecialty": {
					"type": "object", "additionalProperties": false,
					"required": ["version", "luckPerStep", "levelStep"],
					"properties": {
						"version": {"type": "integer", "enum": [1]},
						"luckPerStep": {"type": "integer", "minimum": 0, "maximum": 1000},
						"levelStep": {"type": "integer", "minimum": 1, "maximum": 1000}
					}
				},
				"masterSpellwardSpecialty": {
					"type": "object", "additionalProperties": false,
					"not": {"type": "null"},
					"minProperties": 3, "maxProperties": 3,
					"required": ["version", "percentPerLevel", "maximumExtraPercent"],
					"properties": {
						"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
						"percentPerLevel": {"type": "integer", "minimum": 0, "maximum": 100, "not": {"type": "null"}},
						"maximumExtraPercent": {"type": "integer", "minimum": 0, "maximum": 100, "not": {"type": "null"}}
					}
				},
				"bottomlessMindSpecialty": {
					"type": "object", "additionalProperties": false,
					"not": {"type": "null"},
					"minProperties": 2, "maxProperties": 2,
					"required": ["version", "pointsPerLevel"],
					"properties": {
						"version": {"type": "integer", "enum": [1]},
						"pointsPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000000, "not": {"type": "null"}}
					}
				},
				"arcanePreparationSpecialty": {
					"type": "object", "additionalProperties": false,
					"required": ["version", "initialPercent", "percentPerLevel", "maximumPercent"],
					"properties": {
						"version": {"type": "integer", "enum": [1]},
						"initialPercent": {"type": "integer", "minimum": 0, "maximum": 100},
						"percentPerLevel": {"type": "integer", "minimum": 0, "maximum": 100},
						"maximumPercent": {"type": "integer", "minimum": 0, "maximum": 100}
					}
				},
				"remainingSpellSpecialtyReplacements": {"type": "boolean", "description": "Captured six authored spell-specialty successors. Absence or false preserves original producers; any key presence requires its serialization feature."}
			}
		}
	],
	"definitions": {
