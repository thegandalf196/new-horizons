			"required": ["version", "learningPercentPerLevel", "learningMaximumPercent", "studyExperiencePerMagicPrimaryPoint"],
			"properties": {
				"version": {"type": "integer", "enum": [1], "not": {"type": "null"}},
				"learningPercentPerLevel": {"type": "integer", "minimum": 0, "maximum": 1000, "not": {"type": "null"}},
				"learningMaximumPercent": {"type": "integer", "minimum": 0, "maximum": 200, "not": {"type": "null"}},
				"studyExperiencePerMagicPrimaryPoint": {"type": "integer", "minimum": 0, "maximum": 1000000, "not": {"type": "null"}}
