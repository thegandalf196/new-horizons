{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "New Horizons targeted combat rules v2 (private opt-in)",
	"description": "Strict schemaVersion1/rulesetVersion2, six commands; no v1/default activation. Bounds are arithmetic safety, not balance. JSON non-finite values are not valid input.",
	"type": "object",
	"minProperties": 3,
	"required": [
		"schemaVersion",
		"rulesetVersion",
		"commands"
	],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": {
			"type": "integer",
			"enum": [
				1
			]
		},
		"rulesetVersion": {
			"type": "integer",
			"enum": [
				2
			]
		},
		"commands": {
			"type": "object",
			"minProperties": 6,
			"required": [
				"charge",
				"holdTheLine",
				"advance",
				"aggressive",
				"defensive",
				"focusFire"
			],
			"additionalProperties": false,
			"properties": {
				"charge": {
					"$ref": "#/definitions/order"
				},
				"holdTheLine": {
					"$ref": "#/definitions/order"
				},
				"advance": {
					"$ref": "#/definitions/order"
				},
				"aggressive": {
					"$ref": "#/definitions/doctrine"
				},
				"defensive": {
					"$ref": "#/definitions/doctrine"
				},
				"focusFire": {
					"$ref": "#/definitions/focusFire"
				}
			}
		}
	},
	"definitions": {
		"coefficient": {
			"type": "object",
			"minProperties": 3,
			"required": [
				"base",
				"attack",
				"defense"
			],
			"additionalProperties": false,
			"properties": {
				"base": {
					"type": "number",
					"minimum": -1000000,
					"maximum": 1000000
				},
				"attack": {
					"type": "number",
					"minimum": -1000000,
					"maximum": 1000000
				},
				"defense": {
					"type": "number",
					"minimum": -1000000,
					"maximum": 1000000
				}
			}
		},
		"command": {
			"type": "object",
			"minProperties": 4,
			"required": [
				"kind",
				"coverage",
				"duration",
				"effects"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"type": "string",
					"enum": [
						"order",
						"doctrine"
					]
				},
				"coverage": {
					"type": "string",
					"enum": [
						"ownLivingNonWarMachines"
					]
				},
				"duration": {
					"type": "string",
					"enum": [
						"round",
						"battle"
					]
				},
				"effects": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": false,
					"properties": {
						"meleeDamagePercent": {
							"$ref": "#/definitions/coefficient"
						},
						"rangedDamagePercent": {
							"$ref": "#/definitions/coefficient"
						},
						"damageReductionPercent": {
							"$ref": "#/definitions/coefficient"
						},
						"speedPercent": {
							"$ref": "#/definitions/coefficient"
						}
					}
				}
			}
		},
		"order": {
			"allOf": [
				{
					"$ref": "#/definitions/command"
				},
				{
					"properties": {
						"kind": {
							"enum": [
								"order"
							]
						},
						"duration": {
							"enum": [
								"round"
							]
						}
					}
				}
			]
		},
		"doctrine": {
			"allOf": [
				{
					"$ref": "#/definitions/command"
				},
				{
					"properties": {
						"kind": {
							"enum": [
								"doctrine"
							]
						},
						"duration": {
							"enum": [
								"battle"
							]
						}
					}
				}
			]
		},
		"focusFire": {
			"type": "object",
			"minProperties": 5,
			"required": [
				"kind",
				"coverage",
				"duration",
				"effects",
				"target"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"type": "string",
					"enum": [
						"order"
					]
				},
				"coverage": {
					"type": "string",
					"enum": [
						"ownOrdinaryShootersAtIssue"
					]
				},
				"duration": {
					"type": "string",
					"enum": [
						"round"
					]
				},
				"effects": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": false,
					"properties": {
						"rangedDamagePercent": {
							"$ref": "#/definitions/coefficient"
						}
					},
					"required": [
						"rangedDamagePercent"
					]
				},
				"target": {
					"type": "string",
					"enum": [
						"enemyUnit"
					]
				}
			}
		}
	}
}
