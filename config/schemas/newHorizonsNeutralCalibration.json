{
	"$schema": "http://json-schema.org/draft-04/schema#",
	"type": [
		"object",
		"null"
	],
	"additionalProperties": false,
	"properties": {
		"version": {
			"type": "integer",
			"enum": [
				1
			]
		},
		"enabled": {
			"type": "boolean"
		},
		"curve": {
			"type": "array",
			"minItems": 1,
			"maxItems": 16,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"original",
					"fieldable"
				],
				"properties": {
					"original": {
						"type": "integer",
						"minimum": 1,
						"maximum": 1000000000
					},
					"fieldable": {
						"type": "integer",
						"minimum": 1,
						"maximum": 1000000000
					}
				}
			}
		},
		"stages": {
			"type": "array",
			"minItems": 1,
			"maxItems": 15,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"heroLevel",
					"weeks",
					"unlockedLines",
					"troopGold"
				],
				"properties": {
					"heroLevel": {
						"type": "integer",
						"minimum": 1,
						"maximum": 100
					},
					"weeks": {
						"type": "integer",
						"minimum": 1,
						"maximum": 52
					},
					"unlockedLines": {
						"type": "integer",
						"minimum": 1,
						"maximum": 7
					},
					"troopGold": {
						"type": "integer",
						"minimum": 1,
						"maximum": 1000000
					}
				}
			}
		},
		"unlockWeeks": {
			"type": "array",
			"minItems": 7,
			"maxItems": 7,
			"items": {
				"type": "integer",
				"minimum": 1,
				"maximum": 52
			}
		}
	},
	"anyOf": [
		{
			"maxProperties": 0
		},
		{
			"required": [
				"version",
				"enabled"
			],
			"properties": {
				"enabled": {
					"enum": [
						false
					]
				}
			}
		},
		{
			"required": [
				"version",
				"enabled",
				"curve"
			],
			"properties": {
				"enabled": {
					"enum": [
						true
					]
				}
			},
			"not": {
				"anyOf": [
					{
						"required": [
							"stages"
						]
					},
					{
						"required": [
							"unlockWeeks"
						]
					}
				]
			}
		},
		{
			"required": [
				"version",
				"enabled",
				"stages",
				"unlockWeeks"
			],
			"properties": {
				"enabled": {
					"enum": [
						true
					]
				}
			},
			"not": {
				"required": [
					"curve"
				]
			}
		}
	]
}
