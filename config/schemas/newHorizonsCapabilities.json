{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons hero capability rules",
	"description": "Saved Leadership, Siege, and War Machine shop rules. Ruleset v1 preserves the retired aggregate soft-cap preview; v2 uses independent per-slot creature limits; v3 adds canonical War Machines rank tables; v4 adds the saved universal Blacksmith inventory and faction prices.",
	"type": "object",
	"oneOf": [
		{"maxProperties": 0},
		{
			"required": ["schemaVersion", "rulesetVersion", "classProfiles", "leadership", "siege"],
			"additionalProperties": false,
			"dependencies": {
				"skeletonTransformer": {"properties": {"rulesetVersion": {"enum": [4]}}}
			},
			"allOf": [{
				"oneOf": [
					{
						"not": {"required": ["warMachineShop"]},
						"properties": {
							"rulesetVersion": {"enum": [1]},
							"leadership": {"required": ["skillBonusPercent"]},
							"siege": {"maxProperties": 1}
						}
					},
					{
						"not": {"required": ["warMachineShop"]},
						"properties": {
							"rulesetVersion": {"enum": [2]},
							"leadership": {"required": ["creatureRequirements"]},
							"siege": {"maxProperties": 1}
						}
					},
					{
						"not": {"required": ["warMachineShop"]},
						"properties": {
							"rulesetVersion": {"enum": [3]},
							"leadership": {"required": ["creatureRequirements"]},
							"siege": {"required": ["outputs", "siegeRating", "directControlChance"]}
						}
					},
					{
						"required": ["warMachineShop"],
						"properties": {
							"rulesetVersion": {"enum": [4]},
							"leadership": {"required": ["creatureRequirements"]},
							"siege": {"required": ["outputs", "siegeRating", "directControlChance"]}
						}
					}
				]
			}],
			"properties": {
				"artifactManaRegeneration": {
					"type": "object",
					"required": [
						"core:charmOfMana",
						"core:talismanOfMana",
						"core:mysticOrbOfMana"
					],
					"additionalProperties": false,
					"properties": {
						"core:charmOfMana": {
							"type": "object",
							"required": [
								"minimum",
								"percent"
							],
							"additionalProperties": false,
							"properties": {
								"minimum": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2147483647
								},
								"percent": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2147483647
								}
							}
						},
						"core:talismanOfMana": {
							"type": "object",
							"required": [
								"minimum",
								"percent"
							],
							"additionalProperties": false,
							"properties": {
								"minimum": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2147483647
								},
								"percent": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2147483647
								}
							}
						},
						"core:mysticOrbOfMana": {
							"type": "object",
							"required": [
								"minimum",
								"percent"
							],
							"additionalProperties": false,
							"properties": {
								"minimum": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2147483647
								},
								"percent": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2147483647
								}
							}
						}
					}
				},
				"glyphsOfFearAura": {
					"type": "object",
					"required": [
						"radius",
						"morale"
					],
					"additionalProperties": false,
					"properties": {
						"radius": {
							"type": "integer",
							"minimum": 0,
							"maximum": 2147483647
						},
						"morale": {
							"type": "integer",
							"minimum": -1000,
							"maximum": -1
						}
					}
				},
				"skeletonTransformer": {
					"type": "object",
					"required": ["aggregateHealthPercent"],
					"additionalProperties": false,
					"properties": {"aggregateHealthPercent": {"type": "integer", "minimum": 1, "maximum": 100}}
				},
				"schemaVersion": {"type": "integer", "enum": [1]},
				"rulesetVersion": {"type": "integer", "enum": [1, 2, 3, 4]},
				"classProfiles": {
					"type": "object", "minProperties": 1,
					"additionalProperties": {
						"type": "object", "required": ["base", "perLevel"],
						"additionalProperties": false,
						"properties": {
							"base": {"type": "integer", "minimum": 1, "maximum": 1000000},
							"perLevel": {"type": "integer", "minimum": 0, "maximum": 1000000}
						}
					}
				},
				"leadership": {
					"oneOf": [
						{
							"type": "object", "required": ["skillBonusPercent", "minimumMovementPercent"], "additionalProperties": false,
							"properties": {
								"skillBonusPercent": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 1000}},
								"minimumMovementPercent": {"type": "integer", "minimum": 1, "maximum": 100}
							}
						},
						{
							"type": "object", "required": ["globalScalePercent", "upgradeMultiplierPercent", "upgradeRounding", "creatureRequirements"], "additionalProperties": false,
							"properties": {
								"globalScalePercent": {"type": "integer", "minimum": 1, "maximum": 10000},
								"upgradeMultiplierPercent": {"type": "integer", "minimum": 1, "maximum": 10000},
								"upgradeRounding": {"type": "integer", "minimum": 1, "maximum": 1000},
								"creatureRequirements": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 1000000}}
							}
						}
					]
				},
				"siege": {
					"oneOf": [
						{
							"type": "object", "required": ["ballistaDamageMultiplier"], "additionalProperties": false,
							"properties": {
								"ballistaDamageMultiplier": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 1, "maximum": 100}
								}
							}
						},
						{
							"type": "object", "required": ["ballistaDamageMultiplier", "siegeRating", "outputs", "directControlChance"], "additionalProperties": false,
							"properties": {
								"ballistaDamageMultiplier": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 1, "maximum": 100}
								},
								"siegeRating": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 0, "maximum": 10000}
								},
								"outputs": {
									"type": "object",
									"required": ["ballistaDamage", "catapultStructuralDamage", "firstAidHealing", "defensiveTowerDamage"],
									"additionalProperties": false,
									"properties": {
						"ballistaDamage": {"$ref": "#/definitions/siegeFormula"},
						"catapultStructuralDamage": {"$ref": "#/definitions/siegeFormula"},
						"firstAidHealing": {"$ref": "#/definitions/siegeFormula"},
						"defensiveTowerDamage": {"$ref": "#/definitions/siegeFormula"}
									}
								},
								"directControlChance": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 0, "maximum": 100}
								}
							}
						}
					]
				},
				"warMachineShop": {"$ref": "#/definitions/warMachineShop"}
			}
		}
	],
	"definitions": {
		"warMachineShop": {
			"type": "object",
			"required": ["inventory", "discountPercent", "roundingGold", "favoredMachineByFaction"],
			"additionalProperties": false,
			"properties": {
				"inventory": {
					"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
					"items": {"type": "string", "enum": ["core:ballista", "core:ammoCart", "core:firstAidTent"]}
				},
				"discountPercent": {"type": "integer", "minimum": 1, "maximum": 100},
				"roundingGold": {"type": "integer", "minimum": 1, "maximum": 100000},
				"favoredMachineByFaction": {
					"type": "object", "minProperties": 9, "maxProperties": 9,
					"additionalProperties": {"type": "string", "enum": ["core:ballista", "core:ammoCart", "core:firstAidTent"]}
				}
			}
		},
		"siegeFormula": {
			"type": "object", "required": ["base", "siegeCoefficientHalf"], "additionalProperties": false,
			"properties": {
				"base": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"siegeCoefficientHalf": {"type": "integer", "minimum": 0, "maximum": 1000000}
			}
		}
	}
}
