{
	"$schema": "http://json-schema.org/draft-04/schema",
	"title": "Saved New Horizons leadership and siege rules",
	"description": "Saved Leadership and Siege rules. Ruleset v1 preserves the retired aggregate soft-cap preview; v2 uses the canonical independent per-slot creature limit; v3 adds the canonical War Machines rank tables.",
	"type": "object",
	"oneOf": [
		{"maxProperties": 0},
		{
			"required": ["schemaVersion", "rulesetVersion", "classProfiles", "leadership", "siege"],
			"additionalProperties": false,
			"allOf": [{
				"oneOf": [
					{
						"properties": {
							"rulesetVersion": {"enum": [1]},
							"leadership": {"required": ["skillBonusPercent"]},
							"siege": {"maxProperties": 1}
						}
					},
					{
						"properties": {
							"rulesetVersion": {"enum": [2]},
							"leadership": {"required": ["creatureRequirements"]},
							"siege": {"maxProperties": 1}
						}
					},
					{
						"properties": {
							"rulesetVersion": {"enum": [3]},
							"leadership": {"required": ["creatureRequirements"]},
							"siege": {"required": ["outputs", "siegeRating", "directControlChance"]}
						}
					}
				]
			}],
			"properties": {
				"schemaVersion": {"type": "integer", "enum": [1]},
				"rulesetVersion": {"type": "integer", "enum": [1, 2, 3]},
				"classProfiles": {
					"type": "object", "minProperties": 1,
					"additionalProperties": {
						"type": "object", "required": ["base", "perLevel"],
						"additionalProperties": false,
						"properties": {
							"base": {"type": "integer", "minimum": 1, "maximum": 1000000},
							"perLevel": {"type": "integer", "minimum": 0, "maximum": 1000000}
						}
					}
				},
				"leadership": {
					"oneOf": [
						{
							"type": "object", "required": ["skillBonusPercent", "minimumMovementPercent"], "additionalProperties": false,
							"properties": {
								"skillBonusPercent": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 1000}},
								"minimumMovementPercent": {"type": "integer", "minimum": 1, "maximum": 100}
							}
						},
						{
							"type": "object", "required": ["globalScalePercent", "upgradeMultiplierPercent", "upgradeRounding", "creatureRequirements"], "additionalProperties": false,
							"properties": {
								"globalScalePercent": {"type": "integer", "minimum": 1, "maximum": 10000},
								"upgradeMultiplierPercent": {"type": "integer", "minimum": 1, "maximum": 10000},
								"upgradeRounding": {"type": "integer", "minimum": 1, "maximum": 1000},
								"creatureRequirements": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 1000000}}
							}
						}
					]
				},
				"siege": {
					"oneOf": [
						{
							"type": "object", "required": ["ballistaDamageMultiplier"], "additionalProperties": false,
							"properties": {
								"ballistaDamageMultiplier": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 1, "maximum": 100}
								}
							}
						},
						{
							"type": "object", "required": ["ballistaDamageMultiplier", "siegeRating", "outputs", "directControlChance"], "additionalProperties": false,
							"properties": {
								"ballistaDamageMultiplier": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 1, "maximum": 100}
								},
								"siegeRating": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 0, "maximum": 10000}
								},
								"outputs": {
									"type": "object",
									"required": ["ballistaDamage", "catapultStructuralDamage", "firstAidHealing", "defensiveTowerDamage"],
									"additionalProperties": false,
									"properties": {
						"ballistaDamage": {"$ref": "#/definitions/siegeFormula"},
						"catapultStructuralDamage": {"$ref": "#/definitions/siegeFormula"},
						"firstAidHealing": {"$ref": "#/definitions/siegeFormula"},
						"defensiveTowerDamage": {"$ref": "#/definitions/siegeFormula"}
									}
								},
								"directControlChance": {
									"type": "array", "minItems": 4, "maxItems": 4,
									"items": {"type": "integer", "minimum": 0, "maximum": 100}
								}
							}
						}
					]
				}
			}
		}
	],
	"definitions": {
		"siegeFormula": {
			"type": "object", "required": ["base", "siegeCoefficientHalf"], "additionalProperties": false,
			"properties": {
				"base": {"type": "integer", "minimum": 0, "maximum": 1000000},
				"siegeCoefficientHalf": {"type": "integer", "minimum": 0, "maximum": 1000000}
			}
		}
	}
}
