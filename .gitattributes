*.json linguist-language=JSON-with-Comments
*.h linguist-language=C++
*.cpp linguist-language=C++

*.bat text eol=crlf
# Preserve the existing Windows installer script and Inno translation convention.
/CI/wininstaller/build_installer.cmd text=auto eol=crlf
/CI/wininstaller/installer.iss text=auto eol=crlf
/CI/wininstaller/lang/*.isl text=auto eol=crlf
/android/gradlew text eol=lf

# Preserve the exact pinned upstream recipe inventory on every platform.
# Windows core.autocrlf must not rewrite hashes or existing line endings.
/dependencies/** -text

# Keep the exact local decoder patch stable across Windows checkouts.
/tools/ci/patches/sdl3-image-3.4.4-interlace.patch text eol=lf

# Forecast capabilities attest these reviewed Lua bytes, including imports.
# Keep Windows checkouts identical rather than normalizing unknown scripts.
/scripts/spells/damage.lua text eol=lf
/scripts/spells/timed.lua text eol=lf
/scripts/spells/patches/timedShield.lua text eol=lf
/scripts/spells/patches/timedBind.lua text eol=lf
/scripts/spells/unitEffect.lua text eol=lf
/scripts/battleLog.lua text eol=lf
/scripts/damage/damageCalculator.lua text eol=lf
/scripts/damage/siegeWeapon.lua text eol=lf
/scripts/damage/magicElemental.lua text eol=lf
/scripts/damage/psychicElemental.lua text eol=lf
/scripts/damage/vulnerableFromBack.lua text eol=lf
/scripts/damage/hatesTrait.lua text eol=lf
/scripts/damage/revenge.lua text eol=lf
/scripts/damage/enemyAttackReduction.lua text eol=lf
/scripts/damage/damageReceivedCap.lua text eol=lf
/scripts/combat/focusMagic.lua text eol=lf
/scripts/combat/hexOfPain.lua text eol=lf
/scripts/combat/combatScript.lua text eol=lf

# Match the reviewed corresponding-source snapshot's privacy exclusions.
/CI/deploy_rsa.enc export-ignore
/docs/NH_* export-ignore
# Maintained public input for art importers and regression checks.
/docs/NH_UI_ASSET_INVENTORY.csv -export-ignore
"/docs/design-sources/New Horizons.md" export-ignore
"/docs/design-sources/New Horizons.docx" export-ignore
