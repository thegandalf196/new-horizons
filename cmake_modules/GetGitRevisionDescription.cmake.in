set(HEAD_HASH "")
set(HEAD_REF "")

file(READ "@HEAD_FILE@" HEAD_CONTENTS LIMIT 1024)
string(STRIP "${HEAD_CONTENTS}" HEAD_CONTENTS)
if(HEAD_CONTENTS MATCHES "^ref: (.+)$")
	set(HEAD_REF "${CMAKE_MATCH_1}")
	# Git shares ordinary refs; these three namespaces belong to the worktree.
	set(HEAD_REF_DIR "@GIT_COMMON_DIR@")
	set(HEAD_REF_PRIVATE FALSE)
	if(HEAD_REF MATCHES "^refs/(bisect|worktree|rewritten)/")
		set(HEAD_REF_DIR "@GIT_DIR@")
		set(HEAD_REF_PRIVATE TRUE)
	endif()
	set(HEAD_REF_FILE "${HEAD_REF_DIR}/${HEAD_REF}")
	if(EXISTS "${HEAD_REF_FILE}")
		configure_file("${HEAD_REF_FILE}" "@GIT_DATA@/head-ref" COPYONLY)
		file(READ "@GIT_DATA@/head-ref" HEAD_HASH LIMIT 1024)
	elseif(NOT HEAD_REF_PRIVATE AND EXISTS "@GIT_COMMON_DIR@/packed-refs")
		configure_file("@GIT_COMMON_DIR@/packed-refs" "@GIT_DATA@/packed-refs" COPYONLY)
		file(STRINGS "@GIT_DATA@/packed-refs" PACKED_REFS)
		foreach(PACKED_REF ${PACKED_REFS})
			if(PACKED_REF MATCHES "^([0-9a-fA-F]+) (.+)$")
				if(CMAKE_MATCH_2 STREQUAL HEAD_REF)
					set(HEAD_HASH "${CMAKE_MATCH_1}")
					break()
				endif()
			endif()
		endforeach()
	endif()
else()
	# Detached HEAD was already copied with configure dependency tracking.
	set(HEAD_HASH "${HEAD_CONTENTS}")
endif()
string(STRIP "${HEAD_HASH}" HEAD_HASH)
